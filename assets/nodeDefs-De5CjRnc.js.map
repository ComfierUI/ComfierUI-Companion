  "BakeAmbientOcclusion": {
    "description": "将高模网格的环境光遮蔽贴图烘焙到低模的 UV 布局中（白色 = 开放区域，深色 = 缝隙）。输入已展开 UV 的 low_poly 及其简化前的 high_poly。输出灰度图像，可用于“将纹理应用到网格”的 occlusion 输入（打包到 ORM 贴图 / occlusionTexture 中）。",
    "display_name": "烘焙环境光遮蔽",
    "inputs": {
      "bias": {
        "name": "bias",
        "tooltip": "光线起点离开表面的偏移量，占包围盒对角线的比例。如果平坦表面也出现深色斑点或孔洞，请提高此值。"
      },
      "high_poly": {
        "name": "high_poly"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "max_distance": {
        "name": "max_distance",
        "tooltip": "光线长度，占包围盒对角线的比例。更小 = 更紧凑、更局部的遮蔽。"
      },
      "resolution": {
        "name": "resolution"
      },
      "samples": {
        "name": "samples",
        "tooltip": "每个纹素的光线数。更多 = 更平滑、更慢。出现颗粒感时提高。"
      },
      "strength": {
        "name": "strength",
        "tooltip": "缩放遮蔽效果。>1 变暗，<1 变亮。"
      }
    },
    "outputs": {
      "0": {
        "name": "occlusion",
        "tooltip": null
      }
    }
  },
  "BakeNormalMapFromMesh": {
    "description": "将高模网格的切线空间法线贴图（glTF/OpenGL +Y）烘焙到低模的 UV 布局中，以捕捉简化过程中丢失的细节。输入已展开 UV 的 low_poly 及其简化前的 high_poly。输出图像可用于“将纹理应用到网格”的 normal_map 输入。",
    "display_name": "从网格烘焙法线贴图",
    "inputs": {
      "cage_distance": {
        "name": "cage_distance",
        "tooltip": "表面搜索范围，占包围盒对角线的比例。严重简化后出现错误或缺失区域时提高；如果跨越间隙捕捉到错误表面则降低。"
      },
      "high_poly": {
        "name": "high_poly"
      },
      "ignore_backfaces": {
        "name": "ignore_backfaces",
        "tooltip": "跳过背向纹素的高模表面，避免缝隙或封闭空间捕捉到对侧墙面。仅当高模绕序不一致时禁用。"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "resolution": {
        "name": "resolution"
      }
    },
    "outputs": {
      "0": {
        "name": "normal_map",
        "tooltip": null
      }
    }
  },
  "BakeTextureFromVoxel": {
    "description": "将 PBR 纹理烘焙到网格现有的 UV 布局中（三线性采样稀疏体素体积）。不会进行 UV 展开——请在上游连接 UV 展开节点。输出 base_color 以及 metallic/roughness 灰度 IMAGE（无 PBR 时为黑色）；将它们输入“将纹理应用到网格”（同一网格）以供 SaveGLB 使用。",
    "display_name": "从体素烘焙纹理",
    "inputs": {
      "mesh": {
        "name": "mesh"
      },
      "reference_mesh": {
        "name": "reference_mesh",
        "tooltip": "可选的高密度简化前网格；采样前将每个纹素反投影到其真实表面，从而消除粗糙网格上的多面烘焙效果。"
      },
      "texture_size": {
        "name": "texture_size",
        "tooltip": "方形 UV 图集分辨率。"
      },
      "voxel_colors": {
        "name": "voxel_colors"
      }
    },
    "outputs": {
      "0": {
        "name": "base_color",
        "tooltip": null
      },
      "1": {
        "name": "metallic",
        "tooltip": null
      },
      "2": {
        "name": "roughness",
        "tooltip": null
      }
    }
  },
