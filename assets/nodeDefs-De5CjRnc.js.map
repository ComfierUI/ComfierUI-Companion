  "IdeogramPImage": {
    "description": "使用 P-Image（Ideogram 的快速文本生成图像模型）生成图像。具备强大的字体排版和照片级真实感；支持 Ideogram 4.0 结构化 JSON 标注，实现精确文本、颜色和布局。",
    "display_name": "Ideogram 与 Pruna P-Image",
    "inputs": {
      "aspect_ratio": {
        "name": "aspect_ratio",
        "tooltip": "生成图像的宽高比。"
      },
      "control_after_generate": {
        "name": "control after generate"
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "文本提示。也可接受 Ideogram 4.0 结构化 JSON 标注（精确颜色为 #RRGGBB 十六进制，精确文本字符串，边界框布局）——如需原样使用，请将 prompt_upsampling 设为 OFF。"
      },
      "prompt_upsampling": {
        "name": "prompt_upsampling",
        "tooltip": "在生成前将简短提示扩展为详细结构化标注（重写后的提示作为 final_prompt 返回）。如提供自定义 JSON 标注或精确文本，请设为 OFF。"
      },
      "quality": {
        "name": "quality",
        "tooltip": "速度/价格/质量档位。MEDIUM 为日常默认；HIGH 适用于复杂提示、精细细节和难度较高的文本；VERY_LOW/LOW 适合大规模草稿。MEDIUM 以下难以渲染复杂文本。"
      },
      "resolution": {
        "name": "resolution",
        "tooltip": "输出尺寸等级（具体像素遵循宽高比，例如 16:9 在 1K 时为 1280x720，2K 时为 2560x1440）。建议 HIGH + 2K 以获得清晰的字体排版。"
      },
      "seed": {
        "name": "seed",
        "tooltip": "用于可复现生成的种子。当 prompt_upsampling 设为 OFF 时，相同种子和设置会生成相同图像；ON/AUTO 时，提示重写每次运行都不同——如需复现结果，请用 final_prompt 输出、prompt_upsampling 设为 OFF 及相同种子。"
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      },
      "1": {
        "name": "final_prompt",
        "tooltip": "实际用于生成图像的提示（如启用 prompt_upsampling，则为重写后的结构化标注，否则为原始提示）。如需复现该图像，请用 prompt_upsampling 设为 OFF 及相同种子回传。"
      }
