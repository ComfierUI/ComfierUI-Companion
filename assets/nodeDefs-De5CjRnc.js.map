  "ByteDanceSeedreamLayerSeparationNode": {
    "description": "将一张图像分解为一个背景底板和最多16个可重新定位的透明图层，每个图层具有堆叠顺序、边界框、名称和描述。",
    "display_name": "ByteDance Seedream 5.0 Pro 图层分离（旧版）",
    "inputs": {
      "control_after_generate": {
        "name": "control after generate"
      },
      "crop_layers": {
        "name": "crop_layers",
        "tooltip": "图层/蒙版批量输出的几何方式（layer_stack始终为紧凑）。全画布：每个图层在其边界框位置放置于基础尺寸画布上——可直接用ImageCompositeMasked重组。最小尺寸：每个图层裁剪到其边界框（为批量处理填充到最大图层）——张量更小；用Layers From Bounding Boxes和bboxes输出重建位置。"
      },
      "image": {
        "name": "image",
        "tooltip": "要分离的图像。仅支持一张图像，至少512x512像素，宽高比在1:16到16:1之间。大于约400万像素的输入会在上传前被缩小。"
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "如何分离图像。留空则自动检测并分离所有主要元素。用自然语言描述元素以控制分离，或用<bbox>left top right bottom</bbox>标签（0-1000千分比坐标）精确指定区域。"
      },
      "prompt_optimization": {
        "name": "prompt_optimization",
        "tooltip": "提示词优化模式：'standard' 提供更高质量，'fast' 生成速度更快。"
      },
      "seed": {
        "name": "seed",
        "tooltip": "用于生成的种子。"
      },
      "size": {
        "name": "size",
        "tooltip": "输出分辨率等级。'auto'将跟随输入图像大小（限制在1K-2K范围内）。"
      },
      "watermark": {
        "name": "watermark",
        "tooltip": "是否在图像上添加“AI生成”水印。"
      }
    },
    "outputs": {
      "0": {
        "name": "base_image",
        "tooltip": "图层堆叠的基础图像（背景底板）。"
      },
      "1": {
        "name": "base_mask",
        "tooltip": "基础图像的透明度（1 = 透明，LoadImage 约定）；当前始终为完全不透明。"
      },
      "2": {
        "name": "layers",
        "tooltip": "自下而上排序的透明图层。全画布模式：放置于黑色基础尺寸画布上，位置为其边界框。最小尺寸模式：裁剪到边界框，左上角对齐，填充到最大图层。"
      },
      "3": {
        "name": "masks",
        "tooltip": "每个图层的透明度，与图层批次索引对齐（1 = 透明，LoadImage 约定）。用于ImageCompositeMasked风格合成时，需先添加InvertMask。"
      },
      "4": {
        "name": "bboxes",
        "tooltip": "每个图层一个放置框，与图层批次索引对齐（将两者及masks输入Layers From Bounding Boxes以重建每层位置）：{x, y, width, height, metadata: {name, desc, z_index, native_size, content_rect, flags}}。content_rect = [left, top, width, height] 表示图层在自身框架内的内容区域；最终落在画布上的位置为放置框位置加上该偏移。"
      },
      "5": {
        "name": "layer_stack",
        "tooltip": "用于Create Layered Image的可编辑图层文档：基础底板加每个元素作为独立命名、紧凑裁剪的图层，保持真实位置和堆叠顺序。可直接连接，或用Add Layer扩展。"
      }
    }
  },
