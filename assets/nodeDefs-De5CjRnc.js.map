  "BerniniConditioning": {
    "description": "用于Bernini上下文视频/图像条件的条件节点。可用于以下任务：t2v（文本转视频）、v2v（视频转视频）、rv2v（参考引导视频编辑）、r2v（参考转视频）、ads2v（将图像/视频插入视频）。作为上下文token注入的参考图像（r2v、rv2v）会以其原生宽高比独立编码（长边最大为ref_max_size）。",
    "display_name": "Bernini Conditioning",
    "inputs": {
      "batch_size": {
        "name": "批量大小"
      },
      "height": {
        "name": "高度"
      },
      "length": {
        "name": "长度"
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
