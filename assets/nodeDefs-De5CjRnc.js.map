  "LTXVAddGeneratedKeyframes": {
    "description": "向视频潜空间追加细化关键帧。每个关键帧都是一帧潜空间 token，其 RoPE 位置覆盖单个像素帧；它们会与视频一同去噪，且不属于解码输出。每隔 interval_frames 个像素帧放置一个槽位，跳过 I2V 帧、现有引导以及条件中已有的细化关键帧。连接的关键帧仅作为内容使用，除非设置了 frame_indices，否则会在此画布上重新放置。可使用 LTXV Separate Generated Keyframes 将其取出。需要使用经过生成关键帧训练的检查点（包含 keyframes_abs_pos_embedding）。",
    "display_name": "LTXV 添加生成的关键帧",
    "inputs": {
      "frame_indices": {
        "name": "frame_indices",
        "tooltip": "可选的像素帧索引。留空时，将根据当前画布上的 interval_frames 放置。设置后，此列表即为放置位置（连接的关键帧按顺序匹配）。允许最后一帧；不允许第 0 帧（它已是独立 token）。"
      },
      "interval_frames": {
        "name": "interval_frames",
        "tooltip": "自动放置的像素帧步长。默认值 24 在 24 fps 下约为每秒一个关键帧。会跳过已占用的像素帧。设置 frame_indices 时将忽略此项。"
      },
      "keyframes": {
        "name": "keyframes",
        "tooltip": "可选内容，用于初始化新关键帧。可连接先前 Separate 输出的关键帧（空间尺寸相同），或连接普通视频潜空间以复制每个新槽位处最近的帧（例如时间上采样后）。它们仍会被去噪，不会作为引导固定。除非设置 frame_indices，否则会忽略关键帧潜空间中记录的索引。仅当采样从低于 sigma 1 时开始才有效。"
      },
      "latent": {
        "name": "latent",
        "tooltip": "用于同时生成关键帧的普通 5D 视频潜空间。请在 Concat AV Latent 之前添加它们。"
      },
      "negative": {
        "name": "negative",
        "tooltip": "关键帧所附加的负向条件。"
      },
      "positive": {
        "name": "positive",
        "tooltip": "关键帧所附加的正向条件。"
      },
      "vae": {
        "name": "vae",
        "tooltip": "仅用于读取潜空间缩放系数。"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": "附加了生成关键帧注意力的正向条件。"
      },
      "1": {
        "name": "negative",
        "tooltip": "附加了生成关键帧注意力的负向条件。"
      },
      "2": {
        "name": "latent",
        "tooltip": "在时间维度追加了生成关键帧的视频潜空间。"
      }
    }
  },
  "LTXVAddGuide": {
    "display_name": "LTXV添加指导",
    "inputs": {
      "attention_mask": {
        "name": "attention_mask",
        "tooltip": "可选的像素空间区域 mask。通过自注意力机制并乘以强度，控制每个区域的条件影响。"
      },
      "frame_idx": {
        "name": "帧索引",
        "tooltip": "开始调节的帧索引。对于单帧图像或1-8帧的视频，任何帧索引值都可以接受。对于9+帧的视频，帧索引必须能被8整除，否则它将被向下取整到最接近的8的倍数。负值从视频的末尾开始计算。"
      },
      "iclora_parameters": {
        "name": "iclora_parameters",
        "tooltip": "来自 Get IC-LoRA Parameters 节点的可选 IC-LoRA 参数。用于根据某些 IC-LoRA（如 reference_downscale_factor > 1）需求调整引导处理。链式连接时，每个 LTXVAddGuide 仅使用连接到它的参数。"
      },
      "image": {
        "name": "图像",
