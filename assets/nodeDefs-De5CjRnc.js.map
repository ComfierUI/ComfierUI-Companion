  "SplatToMesh": {
    "description": "从高斯 splat 中提取带颜色的网格。",
    "display_name": "从 Splat 提取网格",
    "inputs": {
      "color_sharpen": {
        "name": "颜色锐化",
        "tooltip": "增强顶点纹理清晰度：1.0=物理正确混合；更高值会让每个体素颜色更偏向主导高斯而非邻域平均（减少纹理模糊）。仅影响颜色，不改变几何。"
      },
      "kernel": {
        "name": "核宽",
        "tooltip": "最大 splat 半宽（体素数）。每个高斯会在自身 3-σ 范围内栅格化，窗口大小受此限制——小的 surfel 计算量低，大的不会被截断。如果稀疏 splat 出现空洞可适当提高。"
      },
      "level": {
        "name": "等值面级别",
        "tooltip": "等值面级别。默认由 Otsu 自动选择；此参数可调整（1.0=自动，数值越低表面越厚/连通性更强，数值越高表面越薄/更紧致）。"
      },
      "min_component": {
        "name": "最小组件",
        "tooltip": "移除小于该顶点数的连通组件（0=保留全部）。可去除悬浮小块和双层壳体的内层。"
      },
      "min_opacity": {
        "name": "最小不透明度",
        "tooltip": "网格化前忽略低于该值的不透明高斯。"
      },
      "resolution": {
        "name": "分辨率",
        "tooltip": "沿最长轴的密度网格分辨率。数值越高，表面越精细，但显存/时间消耗越大（随分辨率的立方增长）。"
      },
      "smooth": {
        "name": "平滑",
        "tooltip": "Taubin 网格平滑迭代次数。可在不缩小体积的情况下平滑表面（与模糊密度不同）。0 表示原始表面。"
      },
      "splat": {
        "name": "splat"
      }
    },
    "outputs": {
      "0": {
        "name": "网格",
        "tooltip": null
      }
    }
  },
