      },
      "latent_idx": {
        "name": "latent_idx",
        "tooltip": "Kılavuzun başlayacağı latent kare indeksi; piksel kareleri yerine latent karelerde sayılır. Negatif değerler, kılavuzu latent'in başlangıcından önceki karelere yerleştirir; sonundan geriye doğru sayılmaz."
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "strength",
