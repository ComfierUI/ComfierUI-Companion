      },
      "guiding_latent": {
        "name": "guiding_latent",
        "tooltip": "Kılavuz latent'i. Uzamsal boyutu, her iki eksende de hedef boyutunu aynı tam sayıya bölmelidir; eşit boyut olduğu gibi sabitler, yarı boyut x2 IC-LoRA referansı olarak değerlendirilir."
      },
      "latent": {
