      },
      "camera_info": {
        "name": "camera_info",
        "tooltip": "Görselin hangi kameradan oluşturulacağını belirtir - bir Yükle3D / Önizleme3D kamerası veya Kamera Bilgisi Oluştur düğümü. Boş bırakılırsa, splat varsayılan 3/4 açıdan otomatik çerçevelenir."
      },
      "frames": {
        "name": "kareler",
        "tooltip": "-1, 0, 1 = tek bir sabit görsel; >1 = döner tabla, kamera tam 360 derece döner (herhangi bir camera_info ile çalışır). Negatif değer ters yönde döner."
      },
      "headlight_shading": {
        "name": "far_gölgeleme",
        "tooltip": "Kameradaki bir ışıktan (far) difüz gölgeleme, splat yüzey normalleri kullanılarak: bakış açısından uzaklaşan yüzeyleri karartır ve form/kavis ortaya çıkarır. 0 = düz albedo, 1 = en güçlü gölgeleme."
      },
      "height": {
        "name": "yükseklik"
      },
