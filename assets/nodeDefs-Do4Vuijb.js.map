  "SplatToMesh": {
    "description": "Bir gaussian splat'tan renkli bir mesh çıkar.",
    "display_name": "Splat'tan Mesh Çıkar",
    "inputs": {
      "color_sharpen": {
        "name": "renk_keskinleştirme",
        "tooltip": "Vertex dokusunu netleştir: 1.0 = fiziksel olarak doğru karışım; daha yüksek değer, her voxel'in rengini komşuların ortalaması yerine baskın gaussian'a yaklaştırır (dokuyu bulanıklıktan arındırır). Sadece renk - geometri değişmez."
      },
      "kernel": {
        "name": "çekirdek",
        "tooltip": "Maksimum splat yarı genişliği (voxel cinsinden). Her gaussian, kendi 3-sigma penceresi kadar rasterize edilir, burada sınırlandırılır - küçük surfeller ucuz kalır, büyükler kesilmez. Seyrek splat'lar boşluk bırakıyorsa artırın."
      },
      "level": {
        "name": "seviye",
        "tooltip": "İzo-yüzey seviyesi. Otsu ile otomatik seçilir; bu değerle kaydırılır (1.0 = otomatik, daha düşük = daha kalın/daha bağlantılı yüzey, daha yüksek = daha ince/daha sıkı)."
      },
      "min_component": {
        "name": "min_bileşen",
        "tooltip": "Bu kadar vertex'ten küçük bağlantılı bileşenleri at. (0 = hepsini tut). Ayrık yüzen parçaları ve çift duvarın iç kabuğunu kaldırır."
      },
      "min_opacity": {
        "name": "min_opaklık",
        "tooltip": "Meshleme öncesi bu değerden daha soluk gaussian'ları yok say."
      },
      "resolution": {
        "name": "çözünürlük",
        "tooltip": "En uzun eksen boyunca yoğunluk-ızgara çözünürlüğü. Daha yüksek = daha ince yüzey, daha fazla VRAM/zaman (çözünürlük^3 ile artar)."
      },
      "smooth": {
        "name": "yumuşatma",
        "tooltip": "Taubin mesh-yumuşatma iterasyonları. Yüzeyi küçültmeden (hacmi koruyarak) yumuşatır, yoğunluğu bulanıklaştırmanın aksine. 0 = ham yüzey."
      },
      "splat": {
        "name": "splat"
      }
    },
    "outputs": {
      "0": {
        "name": "mesh",
        "tooltip": null
      }
    }
  },
