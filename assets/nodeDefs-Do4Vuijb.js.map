  "ByteDanceSeedAudio": {
    "description": "ByteDance Seed Audio 1.0 ile tek bir prompt üzerinden konuşma, müzik, ses efektleri ve çok konuşmacılı diyalog oluşturun. Prompt içinde sesleri, duyguyu, ambiyansı, arka plan müziğini ve ses efektlerini tanımlayın; ayrıca söylenecek satırları ekleyin. İsteğe bağlı olarak yerleşik bir hazır ses seçebilir, en fazla 3 referans klibinden ses klonlayabilir (prompt içinde {'@'}Audio1-3 olarak etiketlenir) veya bir karakter görselinden ses türetebilirsiniz. Çalıştırma başına en fazla 2 dakika ses. Çok dilli model, 20 dili ve zaman damgası tabanlı zamanlama kontrolünü destekler.",
    "display_name": "ByteDance Seed Audio 1.0",
    "inputs": {
      "control_after_generate": {
        "name": "control after generate"
      },
      "loudness_rate": {
        "name": "loudness_rate",
        "tooltip": "Ses yüksekliği. 0 = normal, 100 = 2.0x, -50 = 0.5x."
      },
      "model": {
        "name": "model",
        "tooltip": "seed-audio-1.0-multilingual: 20 dil (İngilizce, Çince, Japonca, Korece, Meksika & Kastilya İspanyolcası, Endonezce, Almanca, Brezilya Portekizcesi, Fransızca, Tayca, Vietnamca, Malayca, Filipince, İtalyanca, Rusça, Hollandaca, Lehçe, Türkçe, İsveççe) ve cümle başına zaman kontrolü \"[5.5s:8.0s] ...\" zaman damgaları ile. seed-audio-1.0: Sadece İngilizce ve Çince, zaman kontrolü yok."
      },
      "pitch_rate": {
        "name": "pitch_rate",
        "tooltip": "Ton kaydırma (yarım ses olarak, -12 ile 12 arası)."
      },
      "reference_mode": {
        "name": "reference_mode",
        "tooltip": "Sesi nasıl koşullandırmak istersiniz: 'yalnızca metin' (her şeyi istemde tanımlayın), 'ses referansı' (en fazla 3 sesi klonlayın, @Audio1-3 olarak etiketlenmiş), 'görsel referansı' (bir karakter görselinden ses türetin) veya 'hazır ses' (istemi okuyan yerleşik isimli bir ses seçin)."
      },
      "sample_rate": {
        "name": "sample_rate",
        "tooltip": "Çıktı örnekleme hızı (Hz cinsinden)."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed, düğümün tekrar çalıştırılıp çalıştırılmayacağını kontrol eder; seed ne olursa olsun sonuçlar deterministik değildir."
      },
      "speech_rate": {
        "name": "speech_rate",
        "tooltip": "Konuşma hızı. 0 = normal, 100 = 2.0x, -50 = 0.5x."
      },
      "text_prompt": {
        "name": "text_prompt",
        "tooltip": "Ses(ler)i, duyguyu, konuşma hızını, ortamı, arka plan müziğini ve ses efektlerini tanımlayın ve konuşulacak replikleri ekleyin (diyalog için karakter isimlerini satır içinde belirtin). 'Ses referansı' modunda, bağlı clip'lere sırasıyla @Audio1, @Audio2, @Audio3 olarak atıfta bulunun. Maksimum 3000 karakter."
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      }
    }
  },
