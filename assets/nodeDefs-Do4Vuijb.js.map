  "BeebleSwitchXImageEdit": {
    "description": "Tek bir görüntüyü Beeble SwitchX ile düzenleyin. Sahnedeki herhangi bir şeyi (arka plan, aydınlatma, kostüm) değiştirirken orijinal öznenin piksellerini korur. Yeni görünümü tanımlamak için bir referans görsel ve/veya metin istemi sağlayın. Maksimum ~2,77MP.",
    "display_name": "Beeble SwitchX Görüntü Düzenleme",
    "inputs": {
      "alpha_mode": {
        "name": "alfa_modu",
        "tooltip": "SwitchX'in neyi koruyup neyi yeniden oluşturacağına nasıl karar verdiğini kontrol eder. 'otomatik' ana özneyi otomatik olarak izole eder. 'doldur' tüm çerçeveyi yeniden oluşturur ve geometrisini korur. 'seç' ilk çerçeve anahtar karesini klip boyunca yayar. 'özel' sizin sağladığınız kare başına alfa maskesini kullanır."
      },
      "control_after_generate": {
        "name": "oluşturduktan sonra kontrol et"
      },
      "image": {
        "name": "görüntü"
      },
      "max_resolution": {
        "name": "maksimum_çözünürlük",
        "tooltip": "Maksimum çıktı çözünürlüğü."
      },
      "prompt": {
        "name": "istem",
        "tooltip": "İstenen çıktının metin açıklaması (maksimum 2000 karakter). 'istem' veya 'referans_görsel'den en az biri gereklidir."
      },
      "reference_image": {
        "name": "referans_görsel",
        "tooltip": "Sonucun görünümünü (arka plan, aydınlatma, kostüm) alacağı referans görsel. 'referans_görsel' veya 'istem'den en az biri gereklidir."
      },
      "seed": {
        "name": "tohum",
        "tooltip": "Tohum, düğümün tekrar çalıştırılıp çalıştırılmayacağını kontrol eder; sonuçlar tohuma bakılmaksızın deterministik değildir."
      }
    },
    "outputs": {
      "0": {
        "name": "görüntü",
        "tooltip": null
      },
      "1": {
        "name": "alfa",
        "tooltip": "Beeble tarafından kullanılan alfa maskesi. Ayrı bir maske olmayan 'doldur' modu için boştur."
      }
    }
  },
