  "BakeAmbientOcclusion": {
    "description": "Yüksek poligonlu bir mesh'ten ortam tıkanıklığı haritasını düşük poligonlu mesh'in UV düzenine işler (beyaz = açık alanlar, koyu = girintiler). UV'si açılmış low_poly'yi ve ondan sadeleştirilmiş high_poly'yi bağlayın. Apply Texture To Mesh'in occlusion girdisi için gri tonlamalı bir görüntü çıkarır (ORM haritasına / occlusionTexture içine paketlenir).",
    "display_name": "Ortam Tıkanıklığını İşle",
    "inputs": {
      "bias": {
        "name": "bias",
        "tooltip": "Sınırlayıcı kutu köşegeninin kesri olarak ışın başlangıcının yüzeyden uzaklığı. Düz yüzeylerde bile koyu lekeler/delikler görünüyorsa artırın."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "max_distance": {
        "name": "max_distance",
        "tooltip": "Sınırlayıcı kutu köşegeninin kesri olarak ışın uzunluğu. Daha küçük = daha sıkı, daha yerel tıkanıklık."
      },
      "resolution": {
        "name": "resolution"
      },
      "samples": {
        "name": "samples",
        "tooltip": "Texel başına ışın sayısı. Daha fazlası = daha pürüzsüz, daha yavaş. Grenliyse artırın."
      },
      "strength": {
        "name": "strength",
        "tooltip": "Tıkanıklığı ölçekler. >1 koyulaştırır, <1 açar."
      }
    },
    "outputs": {
      "0": {
        "name": "occlusion",
        "tooltip": null
      }
    }
  },
  "BakeNormalMapFromMesh": {
    "description": "Yüksek poligonlu bir mesh'ten düşük poligonlu mesh'in UV düzenine, sadeleştirme sırasında kaybolan ayrıntıları yakalayan teğet uzaylı normal haritası (glTF/OpenGL +Y) işler. UV'si açılmış low_poly'yi ve ondan sadeleştirilmiş high_poly'yi bağlayın. Apply Texture To Mesh'in normal_map girdisi için bir görüntü çıkarır.",
    "display_name": "Mesh'ten Normal Haritası İşle",
    "inputs": {
      "cage_distance": {
        "name": "cage_distance",
        "tooltip": "Sınırlayıcı kutu köşegeninin kesri olarak yüzey arama bandı. Yoğun sadeleştirmede yanlış/eksik bölgeler varsa artırın; boşlukların ötesini yakalıyorsa azaltın."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "ignore_backfaces": {
        "name": "ignore_backfaces",
        "tooltip": "Girintilerin/kapalı alanların karşı duvarı yakalamasını önlemek için texel'den uzağa bakan yüksek poligonlu yüzeyleri atlar. Yalnızca high_poly sarım yönü tutarsızsa devre dışı bırakın."
      },
      "low_poly": {
        "name": "low_poly"
      },
      "resolution": {
        "name": "resolution"
      }
    },
    "outputs": {
      "0": {
        "name": "normal_map",
        "tooltip": null
      }
    }
  },
  "BakeTextureFromVoxel": {
    "description": "PBR dokularını mesh'in mevcut UV düzenine işler (seyrek voxel hacmini trilinear örnekler). UV açma işlemi YAPMAZ — yukarı akışta bir UV açma düğümü bağlayın. base_color + metallic/roughness gri tonlamalı IMAGE'ler çıkarır (PBR yoksa siyah); SaveGLB için bunları ApplyTextureToMesh'e (AYNI mesh) bağlayın.",
    "display_name": "Voxel'den Doku İşle",
    "inputs": {
      "mesh": {
        "name": "mesh"
      },
      "reference_mesh": {
        "name": "reference_mesh",
        "tooltip": "İsteğe bağlı, desimasyon öncesi yoğun mesh; her texel'i örneklemeden önce gerçek yüzeyine geri izdüşürerek kaba mesh'lerde fasetli bake işlemini ortadan kaldırır."
      },
      "texture_size": {
        "name": "texture_size",
        "tooltip": "Kare UV atlas çözünürlüğü."
      },
      "voxel_colors": {
        "name": "voxel_colors"
      }
    },
    "outputs": {
      "0": {
        "name": "base_color",
        "tooltip": null
      },
      "1": {
        "name": "metallic",
        "tooltip": null
      },
      "2": {
        "name": "roughness",
        "tooltip": null
      }
    }
  },
