      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "strength",
        "tooltip": "Intensidad de la guía. 1.0 es una fijación rígida; los valores inferiores la suavizan."
      },
      "vae": {
        "name": "vae"
      }
