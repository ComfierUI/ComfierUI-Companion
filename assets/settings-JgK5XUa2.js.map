  "Comfy_Load3D_3DViewerEnable": {
    "name": "Abilita Visualizzatore 3D (Beta)",
    "tooltip": "Abilita il Visualizzatore 3D (Beta) per i nodi selezionati. Questa funzione consente di visualizzare e interagire con modelli 3D direttamente all’interno del visualizzatore 3D a schermo intero."
  },
  "Comfy_Load3D_BackgroundColor": {
    "name": "Colore di sfondo iniziale",
    "tooltip": "Controlla il colore di sfondo predefinito della scena 3D. Questa impostazione determina l’aspetto dello sfondo quando viene creato un nuovo widget 3D, ma può essere regolata individualmente per ogni widget dopo la creazione."
  },
  "Comfy_Load3D_CameraType": {
    "name": "Tipo di camera iniziale",
    "options": {
      "orthographic": "ortografica",
      "perspective": "prospettica"
    },
    "tooltip": "Controlla se la camera è prospettica o ortografica di default quando viene creato un nuovo widget 3D. Questo valore può comunque essere modificato individualmente per ogni widget dopo la creazione."
  },
  "Comfy_Load3D_LightAdjustmentIncrement": {
    "name": "Incremento regolazione luce",
    "tooltip": "Controlla la dimensione dell’incremento durante la regolazione dell’intensità della luce nelle scene 3D. Un valore più piccolo consente un controllo più preciso, mentre un valore più grande comporta cambiamenti più evidenti per ogni regolazione."
  },
  "Comfy_Load3D_LightIntensity": {
    "name": "Intensità luce iniziale",
    "tooltip": "Imposta il livello di luminosità predefinito dell’illuminazione nella scena 3D. Questo valore determina quanto intensamente le luci illuminano gli oggetti quando viene creato un nuovo widget 3D, ma può essere regolato individualmente per ogni widget dopo la creazione."
  },
  "Comfy_Load3D_LightIntensityMaximum": {
    "name": "Intensità massima della luce",
    "tooltip": "Imposta il valore massimo consentito per l’intensità della luce nelle scene 3D. Questo definisce il limite superiore di luminosità che può essere impostato durante la regolazione dell’illuminazione in qualsiasi widget 3D."
  },
  "Comfy_Load3D_LightIntensityMinimum": {
    "name": "Intensità luminosa minima",
    "tooltip": "Imposta il valore minimo consentito per l'intensità della luce nelle scene 3D. Questo definisce il limite inferiore di luminosità che può essere impostato durante la regolazione dell'illuminazione in qualsiasi widget 3D."
  },
  "Comfy_Load3D_PLYEngine": {
    "name": "Motore Point Cloud",
    "options": {
      "fastply": "fastply",
      "threejs": "threejs"
    },
    "tooltip": "Seleziona il motore per il caricamento dei file point cloud PLY. \"threejs\" utilizza il PLYLoader nativo di Three.js (gestisce binario + ASCII, compatibile con mesh). \"fastply\" utilizza un parser ottimizzato per file PLY ASCII. I PLY Gaussian Splat 3D vengono rilevati automaticamente e sempre renderizzati tramite sparkjs indipendentemente da questa impostazione."
  },
  "Comfy_Load3D_ShowGrid": {
    "name": "Visibilità griglia iniziale",
    "tooltip": "Controlla se la griglia è visibile di default quando viene creato un nuovo widget 3D. Questa impostazione predefinita può comunque essere modificata individualmente per ogni widget dopo la creazione."
  },
