  "LayersFromBoundingBoxes": {
    "description": "Wandelt einen Bild-Batch zusammen mit seinen Bounding Boxes in einen Ebenenstapel um, mit einer Ebene pro Frame, die jeweils anhand ihrer eigenen Box positioniert wird. Verwenden Sie dies, wenn ein Node Ebenen als Batch ausgibt – ein Batch hat für jeden Frame eine einzige Positionierung, sodass die individuellen Positionen andernfalls verloren gehen.",
    "display_name": "Ebenen aus Bounding Boxes",
    "inputs": {
      "bboxes": {
        "name": "bboxes",
        "tooltip": "Positionierungsrahmen, indexbündig mit dem Bild-Batch. Akzeptiert Bounding Boxes (x, y, width, height), normalisierte Elemente (mit einer 'bbox' – diese benötigen canvas_width/canvas_height zur Auflösung in Pixel) oder einen JSON-String von beidem. Frames ohne passende Box werden am Ursprung positioniert. Breite/Höhe einer Box skaliert die Ebene passend dazu. metadata.name (oder desc) und metadata.z_index werden verwendet, wenn vorhanden, und metadata.content_rect (frame-relativ) schneidet den Frame auf seinen tatsächlichen Inhalt zu."
      },
      "canvas_height": {
        "name": "canvas_height",
        "tooltip": "Canvas-Höhe des Dokuments. 0 leitet sie aus den positionierten Ebenen ab."
      },
      "canvas_width": {
        "name": "canvas_width",
        "tooltip": "Canvas-Breite des Dokuments. 0 leitet sie aus den positionierten Ebenen ab."
      },
      "crop_to_content": {
        "name": "crop_to_content",
        "tooltip": "Schneidet jeden Frame bei vorhandener metadata.content_rect zu und positioniert den Inhalt an der Boxposition zuzüglich des Rect-Offsets. Lassen Sie dies für Batches mit aufgefüllten Frames aktiviert – es behält nur den tatsächlichen Inhalt an seiner richtigen Position."
      },
      "image": {
        "name": "image",
        "tooltip": "Bild-Batch; jeder Frame wird zu einer Ebene."
      },
      "layers": {
        "name": "layers",
        "tooltip": "Ebenenstapel zum Anhängen. Nicht verbinden, um einen neuen Stapel zu beginnen."
      },
      "mask": {
        "name": "mask",
        "tooltip": "Transparenz pro Frame, indexbündig mit dem Bild-Batch (1 = transparent, LoadImage-Konvention)."
      }
    },
    "outputs": {
      "0": {
        "tooltip": "Der Ebenenstapel, bereit für Create Layered Image."
      }
    }
  },
