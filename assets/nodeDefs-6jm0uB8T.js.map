  "RenderSplat": {
    "description": "Rendert einen Gaussian Splat als Bild mit einem anisotropen EWA-Rasterizer (orientierte elliptische Splats, Antialiasing, nach Tiefe von vorne nach hinten sortiert). Die Kamera stammt von einem camera_info-Eingang (Load / Preview 3D oder einem Create Camera Info-Node); lassen Sie ihn leer, um den Splat automatisch einzupassen. Setzen Sie frames auf einen Wert größer als 1, um einen Turntable-Batch von Bildern zu erzeugen, die einen Video-Node speisen.",
    "display_name": "Splat rendern",
    "inputs": {
      "background": {
        "name": "background"
      },
      "bg_image": {
        "name": "bg_image",
        "tooltip": "Optionales Hintergrundbild, das hinter dem Splat zusammengesetzt wird (überschreibt die einfarbige Hintergrundfarbe). Auf die Rendergröße skaliert; ein Batch wird pro Frame verwendet, ein einzelnes Bild für alle. Nur color/clay."
      },
      "camera_info": {
        "name": "camera_info",
        "tooltip": "Kamera zum Rendern – eine Load3D-/Preview3D-Kamera oder ein Create Camera Info-Node. Wenn leer, wird der Splat automatisch aus einer standardmäßigen 3/4-Ansicht eingerahmt."
      },
      "frames": {
        "name": "frames",
        "tooltip": "-1, 0, 1 = einzelnes Standbild; >1 = Drehteller, die Kamera umkreist während einer vollständigen 360°-Drehung das Objekt (funktioniert mit jedem camera_info). Ein negativer Wert umkreist es in die andere Richtung."
      },
      "headlight_shading": {
        "name": "headlight_shading",
        "tooltip": "Diffuse Schattierung durch ein Licht an der Kamera (Scheinwerfer) unter Verwendung der Surfel-Normalen des Splats: Verdunkelt Flächen, die sich von der Ansicht abwenden, um Form/Krümmung sichtbar zu machen. 0 = flaches Albedo, 1 = stärkste Schattierung."
      },
      "height": {
        "name": "height"
      },
      "opacity_threshold": {
        "name": "opacity_threshold",
        "tooltip": "Gaussians mit einer Opazität unter diesem Wert ausblenden (entfernt schwache schwebende Elemente)."
      },
      "render_style": {
        "name": "render_style",
        "tooltip": "Was die Bildausgabe zeigt: Farbe, Clay (schattiertes neutrales Albedo), Tiefe (nah=hell), Normalen (OpenGL-Normal Map)."
      },
      "sharpen": {
        "name": "sharpen",
        "tooltip": "Überlappende Splats schärfen: 1.0 = physikalisch korrekte Überblendung; höhere Werte gewichten jedes Pixel stärker zum dominanten (nächstgelegenen) Splat für eine schärfere Textur, ohne Splats zu verkleinern oder Lücken zu erzeugen. Über 1 nicht physikalisch."
      },
      "splat": {
        "name": "splat"
      },
      "splat_scale": {
        "name": "splat_scale",
        "tooltip": "Multiplikator für die projizierte Abdeckung jedes Splats (niedriger = schärfere Punkte, höher = weichere/vollere Oberfläche)."
      },
      "width": {
        "name": "width"
      }
    },
    "outputs": {
      "0": {
        "name": "image",
        "tooltip": null
      },
      "1": {
        "name": "mask",
        "tooltip": null
      }
    }
  },
