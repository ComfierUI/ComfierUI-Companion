  "MediaPipeFaceLandmarker": {
    "description": "Erkennt Gesichtslandmarken mithilfe des MediaPipe-Modells.",
    "display_name": "Gesichtslandmarken erkennen (MediaPipe)",
    "inputs": {
      "detector_variant": {
        "name": "detector_variant",
        "tooltip": "Reichweite des Gesichtserkenners. „short“ ist für Nahaufnahmen von Gesichtern optimiert (innerhalb von ~2 m zur Kamera); „full“ deckt weiter entfernte bzw. kleinere Gesichter ab (bis zu ~5 m), ist jedoch langsamer. „both“ führt beide Erkenner aus und behält pro Frame das Ergebnis mit den meisten erkannten Gesichtern bei (~2× Erkennungskosten)."
      },
      "face_detection_model": {
        "name": "face_detection_model"
      },
      "image": {
        "name": "image"
      },
      "min_confidence": {
        "name": "min_confidence",
        "tooltip": "BlazeFace-Score-Schwellenwert. Verringern Sie ihn, um kleine/verdeckt liegende Gesichter zu erfassen."
      },
      "missing_frame_fallback": {
        "name": "missing_frame_fallback",
        "tooltip": "Verhalten pro Frame, wenn die Erkennung in einem Batch fehlschlägt. „empty“ lässt den Frame ohne Gesicht. „previous“ kopiert die zuletzt erfolgreiche Erkennung. „interpolate“ interpoliert landmarks/bbox/blendshapes zwischen den erfolgreichen begrenzenden Frames. Mehrere Gesichter: Ordnet Gesichter über Frames hinweg per gierigem bbox-centre-NN zu."
      },
      "num_faces": {
        "name": "num_faces",
        "tooltip": "Maximale Anzahl zurückzugebender Gesichter pro Frame. 0 = keine Begrenzung (gibt alle erkannten zurück)."
      }
    },
    "outputs": {
      "0": {
        "name": "face_landmarks",
        "tooltip": null
      },
      "1": {
        "name": "bboxes",
        "tooltip": null
      }
    }
  },
