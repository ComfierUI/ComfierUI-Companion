  "IdeogramPImage": {
    "description": "Generiert Bilder mit P-Image, dem schnellen Text-zu-Bild-Modell von Ideogram. Starke Typografie und Fotorealismus; unterstützt strukturierte JSON-Beschriftungen von Ideogram 4.0 für exakten Text, Farben und Layout.",
    "display_name": "Ideogram & Pruna P-Image",
    "inputs": {
      "aspect_ratio": {
        "name": "aspect_ratio",
        "tooltip": "Das Seitenverhältnis für die Bildgenerierung."
      },
      "control_after_generate": {
        "name": "Steuerung nach der Generierung"
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Text-Prompt. Akzeptiert auch eine strukturierte JSON-Beschriftung von Ideogram 4.0 (exakte Farben als #RRGGBB-Hexwerte, exakte Textzeichenfolgen, Bounding-Box-Layout) — setzen Sie prompt_upsampling auf OFF, um sie unverändert zu verwenden."
      },
      "prompt_upsampling": {
        "name": "prompt_upsampling",
        "tooltip": "Erweitert kurze Prompts vor der Generierung zu einer detaillierten strukturierten Beschriftung (der umgeschriebene Prompt wird als final_prompt zurückgegeben). Setzen Sie OFF, wenn Sie Ihre eigene JSON-Beschriftung oder exakte Formulierung bereitstellen."
      },
      "quality": {
        "name": "quality",
        "tooltip": "Stufe für Geschwindigkeit/Preis/Qualität. MEDIUM ist der Standard für den Alltag; HIGH für komplexe Prompts, feine Details und schwierigen Text; VERY_LOW/LOW für Entwürfe im großen Maßstab. Schwieriger Text wird unterhalb von MEDIUM schlecht gerendert."
      },
      "resolution": {
        "name": "resolution",
        "tooltip": "Ausgabegrößenklasse (die exakten Pixel folgen dem Seitenverhältnis, z. B. ergibt 16:9 bei 1K 1280x720 und bei 2K 2560x1440). Bevorzugen Sie HIGH + 2K für scharfe Typografie."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed für reproduzierbare Generierung. Bei prompt_upsampling OFF liefern derselbe Seed und dieselben Einstellungen dasselbe Bild; bei ON/AUTO variiert die Prompt-Überarbeitung pro Durchlauf — reproduzieren Sie ein Ergebnis, indem Sie dessen final_prompt-Ausgabe mit prompt_upsampling OFF und demselben Seed wiederverwenden."
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      },
      "1": {
        "name": "final_prompt",
        "tooltip": "Der Prompt, aus dem das Bild tatsächlich generiert wurde (die umgeschriebene strukturierte Beschriftung, wenn prompt_upsampling ausgeführt wurde, andernfalls Ihr Prompt). Geben Sie ihn mit prompt_upsampling OFF und demselben Seed zurück, um dieses Bild zu reproduzieren."
      }
    }
  },
  "IdeogramPreciseEditApi": {
    "description": "Bearbeitet mithilfe der präzisen Bearbeitung von Ideogram 4.5 ein Bild anhand eines Text-Prompts: Nur das vom Prompt angeforderte Element wird geändert, unveränderte Pixel bleiben identisch und die Ausgabe behält die Größe von Bild 1 bei (Bilder über ~4 MP werden zuerst herunterskaliert). Akzeptiert bis zu 4 Referenzbilder.",
    "display_name": "Ideogram 4.5 Präzises Bearbeiten",
    "inputs": {
      "control_after_generate": {
        "name": "Steuerung nach Generierung"
      },
      "model": {
        "name": "Modell",
