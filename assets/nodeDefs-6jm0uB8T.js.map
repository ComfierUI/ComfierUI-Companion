  "LTXVGeneratedKeyframesToGuides": {
    "description": "Fixiert generierte Keyframes aus einer früheren Phase als eingefrorene Bild-Guides auf einem späteren Canvas. Sie werden als eigenständige Frames decodiert, bei Bedarf skaliert und mit noise_mask=0 geschrieben, damit sie nicht erneut entrauscht werden. Nach einem zeitlichen Upscale werden aufgezeichnete Indizes vom Canvas, auf dem sie generiert wurden, auf diesen skaliert (gleiche Zeitpunkte). Verwenden Sie override_frame_indices, um Positionen explizit festzulegen. Um Keyframes an neuen Positionen weiter zu generieren (und zu entrauschen), verwenden Sie stattdessen Add Generated Keyframes.",
    "display_name": "LTXV Generierte Keyframes zu Guides",
    "inputs": {
      "keyframes": {
        "name": "keyframes",
        "tooltip": "Die Keyframes-Ausgabe von LTXV Separate Generated Keyframes, die den Pixel-Frame-Index enthält, an dem jeder Keyframe generiert wurde."
      },
      "latent": {
        "name": "latent",
        "tooltip": "Das Ziel-Video-Latent, dem die Guides hinzugefügt werden, z. B. das zeitlich hochskalierte."
      },
      "negative": {
        "name": "negative"
      },
      "override_frame_indices": {
        "name": "override_frame_indices",
        "tooltip": "Optional — fixiert an diesen Pixel-Frames statt an den aufgezeichneten (oder automatisch skalierten) Positionen. Geben Sie einen Index pro Keyframe an. Leer lassen, um aufgezeichnete Positionen wiederzuverwenden oder sie zu skalieren, wenn der Ziel-Canvas eine andere Länge hat (z. B. nach zeitlichem x2)."
      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "strength",
        "tooltip": "Guide-Stärke. 1.0 ist eine feste Fixierung; niedrigere Werte lockern sie."
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": "Positives Conditioning mit als Bild-Guides fixierten Keyframes."
      },
      "1": {
        "name": "negative",
        "tooltip": "Negatives Conditioning mit als Bild-Guides fixierten Keyframes."
      },
      "2": {
        "name": "latent",
        "tooltip": "Ziel-Video-Latent mit den als eingefrorene Guides hinzugefügten Keyframes."
      }
    }
  },
