  "LTXVSeparateGeneratedKeyframes": {
    "description": "Trennt die von LTXV Add Generated Keyframes hinzugefügten generierten Keyframes wieder aus einem gesampelten Latent und entfernt sie aus dem Conditioning. Trennen Sie sie vor dem räumlichen Upscale des Video-Latents. Führen Sie nicht zuerst LTXV Crop Guides aus — es behandelt generierte Keyframes als entbehrliche Guides und verwirft sie.",
    "display_name": "LTXV Generierte Keyframes trennen",
    "inputs": {
      "keyframes_to_batch": {
        "name": "keyframes_to_batch",
        "tooltip": "Gibt die Keyframes als Batch von Einzel-Frame-Latents zurück. Deaktiviert lassen, um sie als ein Multi-Frame-Latent zu erhalten, was der Latent-Upsampler und ein späteres Add Generated Keyframes erwarten."
      },
      "latent": {
        "name": "latent"
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": "Positives Conditioning, aus dem Metadaten generierter Keyframes entfernt wurden."
      },
      "1": {
        "name": "negative",
        "tooltip": "Negatives Conditioning, aus dem Metadaten generierter Keyframes entfernt wurden."
      },
      "2": {
        "name": "latent",
        "tooltip": "Video-Latent, aus dem die generierten Keyframes entfernt wurden."
      },
      "3": {
        "name": "keyframes",
        "tooltip": "Die extrahierten Keyframes, gekennzeichnet mit generated_keyframe_indices und generated_keyframe_num_frames. Übergeben Sie diese an ein späteres Add Generated Keyframes, um neue Slots zu initialisieren, oder an Generated Keyframes To Guides, um sie als eingefrorene Bild-Guides zu fixieren (Indizes werden neu zugeordnet, wenn sich die Canvas-Länge geändert hat)."
      }
    }
  },
