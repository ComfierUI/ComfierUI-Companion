  "SplatToMesh": {
    "description": "Extrahiert ein farbiges Mesh aus einem Gaussian Splat.",
    "display_name": "Mesh aus Splat extrahieren",
    "inputs": {
      "color_sharpen": {
        "name": "color_sharpen",
        "tooltip": "Vertex-Textur schärfen: 1.0 = physikalisch korrekte Mischung; höhere Werte verschieben die Farbe jedes Voxels zur dominanten Gaußschen, statt Nachbarn zu mitteln (entfernt Verschmierungen aus der Textur). Nur Farbe – die Geometrie bleibt unverändert."
      },
      "kernel": {
        "name": "Kernel",
        "tooltip": "Maximale halbe Splat-Breite in Voxeln. Jede Gaußsche wird über ein Fenster rasterisiert, dessen Größe ihrem eigenen 3-Sigma-Bereich entspricht und das hier begrenzt wird – kleine Surfels bleiben günstig, große werden nicht abgeschnitten. Erhöhen Sie den Wert, wenn spärliche Splats Lücken hinterlassen."
      },
      "level": {
        "name": "level",
        "tooltip": "Iso-Oberflächenebene. Automatisch per Otsu ausgewählt; dies beeinflusst sie (1.0 = automatisch, niedriger = dickere/stärker verbundene Oberfläche, höher = dünnere/engere Oberfläche)."
      },
      "min_component": {
        "name": "min_component",
        "tooltip": "Verbundene Komponenten mit weniger als dieser Anzahl an Vertices verwerfen (0 = alle behalten). Entfernt abgetrennte schwebende Blobs und die innere Schale der Doppelwand."
      },
      "min_opacity": {
        "name": "min_opacity",
        "tooltip": "Gaußsche mit einer geringeren Opazität als diesem Wert vor dem Meshing ignorieren."
      },
      "resolution": {
        "name": "Auflösung",
        "tooltip": "Dichtegitter-Auflösung entlang der längsten Achse. Höher = feinere Oberfläche, mehr VRAM/Zeit (wächst mit Auflösung^3)."
      },
      "smooth": {
        "name": "smooth",
        "tooltip": "Taubin-Mesh-Glättungsiterationen. Glättet die Oberfläche ohne Schrumpfung (volumenerhaltend), anders als das Weichzeichnen der Dichte. 0 = rohe Oberfläche."
      },
      "splat": {
        "name": "Splat"
      }
    },
    "outputs": {
      "0": {
        "name": "mesh",
        "tooltip": null
      }
    }
  },
