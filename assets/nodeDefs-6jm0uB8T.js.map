  "HiDreamO1PatchSeamSmoothing": {
    "description": "Mittelt die Modellausgabe während des späten Samplingabschnitts über mehrere verschobene Patch-Rasterpositionen. Beseitigt Nähte.",
    "display_name": "HiDream-O1 Patch-Nahtglättung",
    "inputs": {
      "blend": {
        "name": "blend",
        "tooltip": "average: Mittelwert mit gleicher Gewichtung. window: Hann-Fenster-Gewichtung, die jeden Durchlauf fern von seinen Patch-Grenzen bevorzugt. median: Median pro Pixel, verwirft Durchläufe mit Ausreißern durch Umbruch."
      },
      "end_percent": {
        "name": "end_percent",
        "tooltip": "Samplingfortschritt, bei dem die Überblendung deaktiviert wird."
      },
      "model": {
        "name": "model"
      },
      "passes": {
        "name": "passes",
        "tooltip": "Anzahl der Durchläufe pro aktiviertem Schritt. 2/4 = fest. ramp_*: Die Anzahl der Durchläufe steigt, wenn das Sampling sich dem Ende nähert (mehr Glättung, wo Nähte am sichtbarsten sind)."
      },
      "pattern": {
        "name": "pattern",
        "tooltip": "Verschiebungsanordnung. single_shift: ein Durchlauf im natürlichen Patch-Raster + weitere versetzt. symmetric: alle Durchläufe außerhalb des Rasters, Verschiebungen um den Ursprung verteilt."
      },
      "start_percent": {
        "name": "start_percent",
        "tooltip": "Samplingfortschritt (0=Start, 1=Ende), bei dem die Überblendung aktiviert wird."
      },
      "strength": {
        "name": "strength",
        "tooltip": "Interpolation zwischen der Vorhersage im natürlichen Raster (0) und dem gemittelten Ergebnis (1)."
      }
    },
    "outputs": {
