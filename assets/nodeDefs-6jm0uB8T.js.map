  "BakeAmbientOcclusion": {
    "description": "Backt eine Ambient-Occlusion-Map aus einem High-Poly-Mesh in das UV-Layout eines Low-Poly-Meshes (weiß = offen, dunkel = Vertiefungen). Geben Sie das UV-entfaltete low_poly und das high_poly ein, aus dem es dezimiert wurde. Gibt ein Graustufenbild für den occlusion-Eingang von Apply Texture To Mesh aus (in die ORM-Map / occlusionTexture gepackt).",
    "display_name": "Ambient Occlusion backen",
    "inputs": {
      "bias": {
        "name": "bias",
        "tooltip": "Anhebung des Strahlenursprungs über der Oberfläche als Anteil der Bounding-Box-Diagonale. Erhöhen, wenn selbst ebene Oberflächen dunkle Flecken/Löcher zeigen."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "max_distance": {
        "name": "max_distance",
        "tooltip": "Strahllänge als Anteil der Bounding-Box-Diagonale. Kleiner = engere, lokalere Okklusion."
      },
      "resolution": {
        "name": "resolution"
      },
      "samples": {
        "name": "samples",
        "tooltip": "Strahlen pro Texel. Mehr = glatter, langsamer. Erhöhen, wenn körnig."
      },
      "strength": {
        "name": "strength",
        "tooltip": "Skaliert die Okklusion. >1 verdunkelt, <1 hellt auf."
      }
    },
    "outputs": {
      "0": {
        "name": "occlusion",
        "tooltip": null
      }
    }
  },
  "BakeNormalMapFromMesh": {
    "description": "Backt eine Tangentenraum-Normal-Map (glTF/OpenGL +Y) aus einem High-Poly-Mesh in das UV-Layout eines Low-Poly-Meshes und erfasst dabei Details, die bei der Dezimierung verloren gingen. Geben Sie das UV-entfaltete low_poly und das high_poly ein, aus dem es dezimiert wurde. Gibt ein Bild für den normal_map-Eingang von Apply Texture To Mesh aus.",
    "display_name": "Normal Map aus Mesh backen",
    "inputs": {
      "cage_distance": {
        "name": "cage_distance",
        "tooltip": "Oberflächen-Suchbereich als Anteil der Bounding-Box-Diagonale. Bei fehlerhaften oder fehlenden Bereichen nach starker Dezimierung erhöhen; verringern, wenn über Lücken hinweg erfasst wird."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "ignore_backfaces": {
        "name": "ignore_backfaces",
        "tooltip": "Überspringt High-Poly-Oberflächen, die vom Texel weg zeigen, damit Vertiefungen und abgeschlossene Bereiche nicht die gegenüberliegende Wand erfassen. Deaktivieren Sie dies nur, wenn das High-Poly-Winding inkonsistent ist."
      },
      "low_poly": {
        "name": "low_poly"
      },
      "resolution": {
        "name": "resolution"
      }
    },
    "outputs": {
      "0": {
        "name": "normal_map",
        "tooltip": null
      }
    }
  },
  "BakeTextureFromVoxel": {
    "description": "Bäckt PBR-Texturen in das vorhandene UV-Layout des Meshes ein (trilineare Stichproben aus dem sparsamen Voxel-Volumen). Führt KEIN Unwrapping durch – verbinden Sie vorgelagert einen UV-Unwrap-Node. Gibt Graustufen-IMAGEs für base_color sowie metallic/roughness aus (schwarz, wenn kein PBR vorhanden ist); leiten Sie sie für SaveGLB an ApplyTextureToMesh (DASSELBE Mesh) weiter.",
    "display_name": "Textur aus Voxel backen",
    "inputs": {
      "mesh": {
        "name": "mesh"
      },
      "reference_mesh": {
        "name": "reference_mesh",
        "tooltip": "Optionales dichtes Mesh vor der Dezimierung; projiziert jedes Texel vor dem Sampling zurück auf seine tatsächliche Oberfläche und entfernt dadurch facettiertes Baking bei groben Meshes."
      },
      "texture_size": {
        "name": "texture_size",
        "tooltip": "Quadratische UV-Atlasauflösung."
      },
      "voxel_colors": {
        "name": "voxel_colors"
      }
    },
    "outputs": {
      "0": {
        "name": "base_color",
        "tooltip": null
      },
      "1": {
        "name": "metallic",
        "tooltip": null
      },
      "2": {
        "name": "roughness",
        "tooltip": null
      }
    }
  },
