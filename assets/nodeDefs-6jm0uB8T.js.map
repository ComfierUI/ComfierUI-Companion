  "ByteDanceSeedreamLayerSeparationNode": {
    "description": "Zerlegt ein Bild in eine Hintergrundebene und bis zu 16 neu positionierbare transparente Ebenen, jeweils mit Stapelreihenfolge, Begrenzungsrahmen, Name und Beschreibung.",
    "display_name": "ByteDance Seedream 5.0 Pro Ebenentrennung (Legacy)",
    "inputs": {
      "control_after_generate": {
        "name": "Steuerung nach Generierung"
      },
      "crop_layers": {
        "name": "crop_layers",
        "tooltip": "Geometrie der Batch-Ausgaben für Ebenen/Masken (layer_stack bleibt unverändert und immer eng zugeschnitten). Volle Canvas: jede Ebene auf einer Canvas in Basisgröße an ihrer Bounding-Box-Position – direkt mit ImageCompositeMasked neu zusammensetzen. Minimale Größe: jede Ebene auf ihre Bounding Box zugeschnitten (für Batching auf die größte Ebene aufgefüllt) – deutlich kleinere Tensoren; Platzierung mit Layers From Bounding Boxes unter Verwendung der Ausgabe bboxes wiederherstellen."
      },
      "image": {
        "name": "image",
        "tooltip": "Das zu trennende Bild. Genau ein Bild mit mindestens 512x512 Pixeln und einem Seitenverhältnis zwischen 1:16 und 16:1. Eingaben größer als etwa 4 MP werden vor dem Upload verkleinert."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "So trennen Sie das Bild. Leer lassen, um alle wichtigen Elemente automatisch zu erkennen und zu trennen. Beschreiben Sie Elemente in natürlicher Sprache, um die Trennung zu steuern, oder legen Sie genaue Bereiche mit <bbox>left top right bottom</bbox>-Tags fest (0–1000-Promillekoordinaten)."
      },
      "prompt_optimization": {
        "name": "prompt_optimization",
        "tooltip": "Prompt-Optimierungsmodus: „standard“ bietet höhere Qualität, „fast“ eine kürzere Generierungszeit."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Für die Generierung zu verwendender Seed."
      },
      "size": {
        "name": "size",
        "tooltip": "Ausgabeauflösungsstufe. „auto“ folgt der Größe des Eingabebilds (begrenzt auf den Bereich 1K–2K)."
      },
      "watermark": {
        "name": "watermark",
        "tooltip": "Ob den Bildern ein Wasserzeichen „AI generated“ hinzugefügt werden soll."
      }
    },
    "outputs": {
      "0": {
        "name": "base_image",
        "tooltip": "Das Basisbild (Hintergrundplatte), auf dem die Ebenen gestapelt werden."
      },
      "1": {
        "name": "base_mask",
        "tooltip": "Transparenz des Basisbilds (1 = transparent, LoadImage-Konvention); derzeit immer vollständig deckend."
      },
      "2": {
        "name": "layers",
        "tooltip": "Transparente Ebenen, von unten nach oben angeordnet. Modus „Volle Canvas“: an ihrer Bounding-Box-Position auf einer schwarzen Canvas in Basisgröße platziert. Modus „Minimale Größe“: auf ihre Bounding Box zugeschnitten, oben links verankert und auf die größte Ebene aufgefüllt."
      },
      "3": {
        "name": "masks",
        "tooltip": "Transparenz pro Ebene, indexausgerichtet mit dem Batch layers (1 = transparent, LoadImage-Konvention). Für Compositing im Stil von ImageCompositeMasked fügen Sie zuerst InvertMask hinzu."
      },
      "4": {
        "name": "bboxes",
        "tooltip": "Eine Platzierungsbox pro Ebene, indexausgerichtet mit dem Batch layers (führen Sie beide zusammen mit masks in Layers From Bounding Boxes ein, um die Platzierung pro Ebene wiederherzustellen): {x, y, width, height, metadata: {name, desc, z_index, native_size, content_rect, flags}}. content_rect = [left, top, width, height] ist der Inhaltsbereich der Ebene innerhalb ihres eigenen Rahmens; er wird auf der Canvas an der Boxposition zuzüglich dieses Offsets platziert."
      },
      "5": {
        "name": "layer_stack",
        "tooltip": "Bearbeitungsfertiges Ebenendokument für Create Layered Image: die Basisplatte sowie jedes Element als eigene benannte, eng zugeschnittene Ebene an seiner tatsächlichen Position und in seiner Stapelreihenfolge. Direkt verbinden oder mit Add Layer erweitern."
      }
    }
  },
  "ByteDanceSeedreamLayerSeparationNodeV2": {
    "description": "Zerlegt ein Bild in eine Hintergrundplatte und bis zu 16 verschiebbare transparente Ebenen, jeweils mit Stapelreihenfolge, Begrenzungsrahmen, Namen und Beschreibung.",
