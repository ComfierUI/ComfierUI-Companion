  "BeebleSwitchXImageEdit": {
    "description": "Bearbeiten Sie ein einzelnes Bild mit Beeble SwitchX. Ändert alles in der Szene (Hintergrund, Beleuchtung, Kostüm), während die Pixel des ursprünglichen Subjekts erhalten bleiben. Geben Sie ein Referenzbild und/oder einen Text-Prompt an, um den neuen Look zu beschreiben. Max. ~2,77 MP.",
    "display_name": "Beeble SwitchX-Bildbearbeitung",
    "inputs": {
      "alpha_mode": {
        "name": "alpha_mode",
        "tooltip": "Steuert, wie SwitchX entscheidet, was beibehalten oder neu generiert wird. 'auto' isoliert automatisch das Hauptsubjekt. 'fill' generiert den gesamten Frame neu und bewahrt dabei die Geometrie. 'select' überträgt ein Keyframe des ersten Frames auf den gesamten Clip. 'custom' verwendet eine von Ihnen bereitgestellte Alpha-Matte pro Frame."
      },
      "control_after_generate": {
        "name": "Steuerung nach Generierung"
      },
      "image": {
        "name": "image"
      },
      "max_resolution": {
        "name": "max_resolution",
        "tooltip": "Maximale Ausgabeauflösung."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Textbeschreibung der gewünschten Ausgabe (max. 2000 Zeichen). Mindestens eines von 'prompt' oder 'reference_image' ist erforderlich."
      },
      "reference_image": {
        "name": "reference_image",
        "tooltip": "Referenzbild, dessen Erscheinungsbild (Hintergrund, Beleuchtung, Kostüm) das Ergebnis übernehmen soll. Mindestens eines von „reference_image“ oder „prompt“ ist erforderlich."
      },
      "seed": {
        "name": "Seed",
        "tooltip": "Der Seed steuert, ob der Node erneut ausgeführt werden soll; die Ergebnisse sind unabhängig vom Seed nicht deterministisch."
      }
    },
    "outputs": {
      "0": {
        "name": "Bild",
        "tooltip": null
      },
      "1": {
        "name": "Alpha",
        "tooltip": "Die von Beeble verwendete Alpha-Matte. Leer im Modus „fill“, der keine separate Matte besitzt."
      }
    }
  },
  "BeebleSwitchXVideoEdit": {
    "description": "Bearbeiten Sie ein Video mit Beeble SwitchX. Tauscht alles in der Szene (Hintergrund, Beleuchtung, Kostüm) aus, während die Pixel und die Bewegung des ursprünglichen Motivs erhalten bleiben. Geben Sie ein Referenzbild und/oder einen Text-Prompt an, um den neuen Look zu beschreiben. Maximal 240 Frames, maximal ca. 2,77 MP pro Frame.",
    "display_name": "Beeble SwitchX Video Edit",
    "inputs": {
      "alpha_mode": {
        "name": "alpha_mode",
        "tooltip": "Steuert, wie SwitchX entscheidet, was beibehalten bzw. neu generiert wird. „auto“ isoliert das Hauptmotiv automatisch. „fill“ generiert den gesamten Frame unter Beibehaltung der Geometrie neu. „select“ überträgt einen Keyframe des ersten Frames auf den gesamten Clip. „custom“ verwendet eine von Ihnen bereitgestellte Alpha-Matte pro Frame."
      },
      "control_after_generate": {
        "name": "Steuerung nach Generierung"
      },
      "max_resolution": {
        "name": "max_resolution",
        "tooltip": "Maximale Ausgabeauflösung."
      },
      "prompt": {
        "name": "Prompt",
        "tooltip": "Textbeschreibung der gewünschten Ausgabe (max. 2000 Zeichen). Mindestens eines von „prompt“ oder „reference_image“ ist erforderlich."
      },
      "reference_image": {
        "name": "reference_image",
        "tooltip": "Referenzbild, dessen Erscheinungsbild (Hintergrund, Beleuchtung, Kostüm) das Ergebnis übernehmen soll. Mindestens eines von „reference_image“ oder „prompt“ ist erforderlich."
      },
      "seed": {
        "name": "Seed",
        "tooltip": "Der Seed steuert, ob der Node erneut ausgeführt werden soll; die Ergebnisse sind unabhängig vom Seed nicht deterministisch."
      },
      "video": {
        "name": "Video"
      }
    },
    "outputs": {
      "0": {
        "name": "Video",
        "tooltip": null
      },
      "1": {
        "name": "Alpha",
        "tooltip": "Die von Beeble verwendete Alpha-Matte. Leer im Modus „fill“, der keine separate Matte besitzt."
      }
    }
  },
  "BerniniConditioning": {
    "description": "Conditioning-Node für das In-Context-Conditioning von Bernini für Videos/Bilder. Er kann für folgende Aufgaben verwendet werden: t2v (Text-zu-Video), v2v (Video-zu-Video), rv2v (referenzgestützte Videobearbeitung), r2v (Referenz-zu-Video), ads2v (Bild/Video in Video einfügen). Als In-Context-Tokens eingefügte Referenzbilder (r2v, rv2v) werden unabhängig in ihrem nativen Seitenverhältnis kodiert (lange Kante auf ref_max_size begrenzt).",
    "display_name": "Bernini Conditioning",
    "inputs": {
      "batch_size": {
        "name": "batch_size"
      },
      "height": {
        "name": "height"
      },
      "length": {
        "name": "length"
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "ref_max_size": {
        "name": "ref_max_size",
        "tooltip": "Maximale Größe für die lange Kante von reference_video und reference_images. Die Größe wird unter Beibehaltung des Seitenverhältnisses angepasst und auf 16px gerundet."
      },
      "reference_images": {
        "name": "reference_images"
      },
      "reference_video": {
        "name": "reference_video",
        "tooltip": "Video, das in das Quellvideo eingefügt werden soll (ads2v)."
      },
      "source_video": {
        "name": "source_video",
        "tooltip": "Zu bearbeitendes oder umzustilisierendes Quellvideo (v2v, rv2v). Wird auf width/height skaliert und auf length gekürzt."
      },
      "vae": {
        "name": "vae"
      },
      "width": {
        "name": "width"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "negative",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
