  "LTXVAddGeneratedKeyframes": {
    "description": "Hängt einem Video-latent detaillierende Keyframes an. Jedes Keyframe besteht aus einem latent-Frame von Tokens, dessen RoPE-Position einen einzelnen Pixelframe abdeckt; sie werden zusammen mit dem Video entrauscht und sind nicht Teil der dekodierten Ausgabe. Die Platzierung erfolgt mit einem Slot pro interval_frames Pixel, wobei I2V-Frames, vorhandene Guides und bereits an die Konditionierung angehängte detaillierende Keyframes übersprungen werden. Verbundene Keyframes sind nur Inhalt und werden auf diesem Canvas neu platziert, sofern frame_indices nicht festgelegt ist. Extrahieren Sie sie mit LTXV Separate Generated Keyframes wieder. Erfordert einen für generierte Keyframes trainierten Checkpoint (mit keyframes_abs_pos_embedding).",
    "display_name": "LTXV Generierte Keyframes hinzufügen",
    "inputs": {
      "frame_indices": {
        "name": "frame_indices",
        "tooltip": "Optionale Pixelframe-Indizes. Lassen Sie dieses Feld leer, um anhand von interval_frames auf dem aktuellen Canvas zu platzieren. Wenn festgelegt, bestimmt diese Liste die Platzierung (verbundene Keyframes werden der Reihe nach zugeordnet). Der letzte Frame ist zulässig; Frame 0 nicht (er ist bereits ein eigenständiges Token)."
      },
      "interval_frames": {
        "name": "interval_frames",
        "tooltip": "Pixelframe-Schrittweite für die automatische Platzierung. Der Standardwert 24 entspricht bei 24 fps etwa einem Keyframe pro Sekunde. Belegte Pixel werden übersprungen. Wird ignoriert, wenn frame_indices festgelegt ist."
      },
      "keyframes": {
        "name": "keyframes",
        "tooltip": "Optionaler Inhalt zur Initialisierung der neuen Keyframes. Verbinden Sie Keyframes aus einem früheren Separate (gleiche räumliche Größe) oder ein einfaches Video-latent, um an jedem neuen Slot den nächstgelegenen Frame zu kopieren (z. B. nach temporalem Upscale). Diese werden weiterhin entrauscht und nicht als Guides fixiert. Auf einem Keyframes-latent gespeicherte Indizes werden ignoriert, sofern frame_indices nicht festgelegt ist. Hat nur Wirkung, wenn das Sampling unterhalb von Sigma 1 beginnt."
      },
      "latent": {
        "name": "latent",
        "tooltip": "Einfaches 5D-Video-latent, für das parallel Keyframes generiert werden. Fügen Sie sie vor Concat AV Latent hinzu."
      },
      "negative": {
        "name": "negative",
        "tooltip": "Negative Konditionierung, an die die Keyframes angehängt werden."
      },
      "positive": {
        "name": "positive",
        "tooltip": "Positive Konditionierung, an die die Keyframes angehängt werden."
      },
      "vae": {
        "name": "vae",
        "tooltip": "Wird nur zum Lesen der latent-Skalierungsfaktoren verwendet."
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": "Positive Konditionierung mit angehängter Attention für generierte Keyframes."
      },
      "1": {
        "name": "negative",
        "tooltip": "Negative Konditionierung mit angehängter Attention für generierte Keyframes."
      },
      "2": {
        "name": "latent",
        "tooltip": "Video-latent mit an T angehängten generierten Keyframes."
      }
    }
  },
  "LTXVAddGuide": {
    "display_name": "LTXVAddGuide",
    "inputs": {
      "attention_mask": {
        "name": "Attention-Maske",
        "tooltip": "Optionale räumliche mask im Pixelraum. Steuert den Konditionierungseinfluss pro Bereich über Self-Attention, multipliziert mit der Stärke."
      },
      "frame_idx": {
        "name": "Frame-Index",
        "tooltip": "Frame-Index, bei dem die Konditionierung beginnen soll. Für Einzelbilder oder Videos mit 1–8 Frames ist jeder frame_idx-Wert zulässig. Bei Videos mit mehr als 9 Frames muss frame_idx durch 8 teilbar sein, andernfalls wird er auf das nächstniedrigere Vielfache von 8 abgerundet. Negative Werte werden vom Ende des Videos aus gezählt."
      },
      "iclora_parameters": {
        "name": "IC-LoRA-Parameter",
        "tooltip": "Optionale IC-LoRA-Parameter aus einem Node „Get IC-LoRA Parameters“. Werden verwendet, um die Guide-Verarbeitung anzupassen, wie es bestimmte IC-LoRAs erfordern (z. B. solche mit reference_downscale_factor > 1). Bei Verkettung verwendet jedes LTXVAddGuide nur die mit ihm verbundenen Parameter."
      },
      "image": {
        "name": "Bild",
        "tooltip": "Bild oder Video zur Konditionierung des latenten Videos. Muss 8*n + 1 Frames enthalten. Wenn das Video nicht 8*n + 1 Frames enthält, wird es auf die nächstgelegene Anzahl von 8*n + 1 Frames zugeschnitten."
      },
      "latent": {
        "name": "latent"
      },
      "negative": {
        "name": "Negativ"
      },
      "positive": {
        "name": "Positiv"
      },
      "strength": {
        "name": "Stärke"
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "Positiv",
        "tooltip": null
      },
      "1": {
        "name": "Negativ",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
  "LTXVAddLatentGuide": {
    "description": "Fixiert ein bereits kodiertes latent als Guide, wenn der Guide aus einer früheren Stufe statt aus einem Bild stammt. Gleiche Wirkung wie LTXV Add Guide ohne den VAE-Dekodierungs-/Kodierungsdurchlauf. Ein räumlich kleinerer Guide als das Ziel (eine IC-LoRA- oder Detaillierungsreferenz) wird auf ein dünnes Raster erweitert, und seine RoPE-Endpositionen werden um denselben Faktor erweitert, sodass er den Ziel-Canvas abdeckt, statt nur dessen obere linke Ecke anzusprechen.",
    "display_name": "LTXV Latent-Guide hinzufügen",
    "inputs": {
      "attention_mask": {
        "name": "attention_mask",
        "tooltip": "Optionale räumliche Maske im Pixelraum. Steuert den Einfluss der Konditionierung pro Region über Self-Attention, multipliziert mit strength."
      },
      "guiding_latent": {
        "name": "guiding_latent",
        "tooltip": "Guide-latent. Seine räumliche Größe muss die des Ziels auf beiden Achsen durch dieselbe ganze Zahl teilen; bei gleicher Größe wird es unverändert fixiert, bei halber Größe als x2-IC-LoRA-Referenz behandelt."
      },
      "latent": {
        "name": "latent",
        "tooltip": "Ziel-Video-latent, auf dem der Guide fixiert wird."
      },
      "latent_idx": {
        "name": "latent_idx",
        "tooltip": "Latent-Frame-Index, an dem der Guide beginnen soll; er wird in latent-Frames statt in Pixelframes gezählt. Negative Werte platzieren den Guide auf Frames vor dem Beginn des latent und werden nicht vom Ende zurückgezählt."
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "strength",
        "tooltip": "Auf 1.0 begrenzt. Ein erweiterter Guide markiert seine Padding-Positionen mit einer negativen Denoising-Maske, sodass das Modell sie verwirft; über 1.0 würden auch die beibehaltenen Positionen negativ und der gesamte Guide würde verworfen. Verstärken Sie über 1.0 stattdessen mit attention_mask."
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "negative",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
