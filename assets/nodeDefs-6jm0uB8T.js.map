      },
      "width": {
        "name": "width",
        "tooltip": "Anfängliche Anzeigebreite. 0 behält die native Breite des Bildes bei."
      },
      "x": {
        "name": "x",
        "tooltip": "Anfängliche horizontale Platzierung auf dem Canvas."
      },
      "y": {
        "name": "y",
        "tooltip": "Anfängliche vertikale Platzierung auf dem Canvas."
      },
      "z_index": {
        "name": "z_index",
        "tooltip": "Staplungsüberschreibung. Ebenen werden stabil nach z_index sortiert; gleiche Werte behalten ihre Listenreihenfolge."
