  "SplatToMesh": {
    "description": "從高斯 splat 擷取帶有顏色的網格。",
    "display_name": "從 Splat 擷取網格",
    "inputs": {
      "color_sharpen": {
        "name": "顏色銳化",
        "tooltip": "使頂點紋理更清晰：1.0 = 物理正確混合；更高則使每個體素的顏色偏向其主導高斯而非鄰近平均（減少紋理模糊）。僅影響顏色，不改變幾何。"
      },
      "kernel": {
        "name": "核心",
        "tooltip": "最大 splat 半寬（以體素為單位）。每個高斯會在以自身 3-sigma 為大小的視窗內光柵化，最大值由此設定——小的 surfel 保持高效，大的則不會被截斷。如稀疏 splat 出現空隙可提高此值。"
      },
      "level": {
        "name": "等值面層級",
        "tooltip": "等值面層級。預設由 Otsu 自動選取；此參數可調整其偏好（1.0 = 自動，較低 = 表面更厚/連接性更高，較高 = 表面更薄/更緊密）。"
      },
      "min_component": {
        "name": "最小組件",
        "tooltip": "移除小於此頂點數的連通組件（0 = 保留全部）。可去除分離的浮動塊與雙層牆的內殼。"
      },
      "min_opacity": {
        "name": "最小不透明度",
        "tooltip": "網格化前忽略低於此值的不透明高斯。"
      },
      "resolution": {
        "name": "解析度",
        "tooltip": "沿最長軸的密度網格解析度。數值越高，表面越細緻，但會消耗更多 VRAM/時間（隨解析度^3 增長）。"
      },
      "smooth": {
        "name": "平滑",
        "tooltip": "Taubin 網格平滑迭代次數。可平滑表面但不會縮小體積（與模糊密度不同）。0 = 原始表面。"
      },
      "splat": {
        "name": "splat"
      }
    },
    "outputs": {
      "0": {
        "name": "網格",
        "tooltip": null
      }
    }
  },
