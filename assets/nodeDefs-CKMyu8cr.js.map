  "WanAnimate2Cache": {
    "description": "快取姿勢影片每個區塊的啟動值，因此只需運行一次，而非每個取樣步驟都運行。大約可將生成時間減半。權衡是以 bf16 格式在 480x832/81 幀下約需 12.5 GB 系統記憶體（會隨解析度與長度變動）。若使用 context windows，每個 window 會分別快取，因此記憶體用量會隨 window 數量增加；建議使用 static_standard 排程，因為 uniform 排程會在每一步移動 window，導致快取無法重複利用。",
    "display_name": "WanAnimate2Cache",
    "inputs": {
      "device": {
        "name": "device",
        "tooltip": "快取儲存位置。cpu（記憶體）是最安全的選擇，因為快取通常無法與模型同時放入 VRAM。gpu（顯示卡記憶體）若容量足夠則可更快。"
      },
      "dtype": {
        "name": "dtype",
        "tooltip": "儲存精度。default 會以模型運算精度儲存啟動值。int8 可將快取減半，int4 減為四分之一，convrot 用於保留精度。"
      },
      "model": {
        "name": "model"
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      }
    }
  },
