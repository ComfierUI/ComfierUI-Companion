  "LTXVAddGeneratedKeyframes": {
    "description": "將細節關鍵影格附加至影片 latent。每個關鍵影格都是由 token 組成的一個 latent 影格，其 RoPE 位置涵蓋單一像素影格；它們會與影片一同去雜訊，且不屬於解碼輸出的一部分。會每隔 interval_frames 個像素影格放置一個位置，略過 I2V 影格、既有引導及 cond 上已有的細節關鍵影格。連接的關鍵影格僅作為內容使用，除非設定 frame_indices，否則會在此畫布上重新放置。可使用 LTXV Separate Generated Keyframes 將其取出。需要使用針對生成關鍵影格訓練的 checkpoint（含有 keyframes_abs_pos_embedding 的 checkpoint）。",
    "display_name": "LTXV 新增生成關鍵影格",
    "inputs": {
      "frame_indices": {
        "name": "frame_indices",
        "tooltip": "可選的像素影格索引。留空時，會依目前畫布上的 interval_frames 放置。設定後，此清單即為放置位置（依序對應連接的關鍵影格）。允許最後一個影格；不允許影格 0（它已經是獨立 token）。"
      },
      "interval_frames": {
        "name": "interval_frames",
        "tooltip": "自動放置的像素影格步長。預設值 24 在 24 fps 時約為每秒一個關鍵影格。已占用的像素影格會略過。設定 frame_indices 時會忽略此值。"
      },
      "keyframes": {
        "name": "keyframes",
        "tooltip": "可選擇用於初始化新關鍵影格的內容。可連接先前 Separate 輸出的關鍵影格（相同空間尺寸），或連接普通影片 latent，以在每個新位置複製最近的影格（例如時間放大後）。這些影格仍會去雜訊，而不會固定為引導。除非設定 frame_indices，否則會忽略 keyframes latent 上記錄的索引。僅當採樣從低於 sigma 1 開始時才有效果。"
      },
      "latent": {
        "name": "latent",
        "tooltip": "用於一併生成關鍵影格的普通 5D 影片 latent。請在 Concat AV Latent 之前新增它們。"
      },
      "negative": {
        "name": "negative",
        "tooltip": "關鍵影格所附加的負向條件。"
      },
      "positive": {
        "name": "positive",
        "tooltip": "關鍵影格所附加的正向條件。"
      },
      "vae": {
        "name": "vae",
        "tooltip": "僅用於讀取 latent 縮放係數。"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": "附加生成關鍵影格注意力的正向條件。"
      },
      "1": {
        "name": "negative",
        "tooltip": "附加生成關鍵影格注意力的負向條件。"
      },
      "2": {
        "name": "latent",
        "tooltip": "於 T 維度附加生成關鍵影格的影片 latent。"
      }
    }
  },
  "LTXVAddGuide": {
