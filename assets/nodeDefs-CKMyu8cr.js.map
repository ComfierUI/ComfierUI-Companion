  "BeebleSwitchXImageEdit": {
    "description": "使用 Beeble SwitchX 編輯單張圖像。可切換場景中的任何元素（背景、光線、服裝），同時保留原始主體像素。請提供參考圖像及／或文字提示以描述新外觀。最大約 2.77MP。",
    "display_name": "Beeble SwitchX 圖像編輯",
    "inputs": {
      "alpha_mode": {
        "name": "alpha 模式",
        "tooltip": "控制 SwitchX 如何決定保留或重建內容。「auto」自動分離主要主體。「fill」重建整個畫面並保留幾何結構。「select」將首幀關鍵影格套用至整個 clip。「custom」使用您提供的每幀 alpha 遮罩。"
      },
      "control_after_generate": {
        "name": "生成後控制"
      },
      "image": {
        "name": "圖像"
      },
      "max_resolution": {
        "name": "最大解析度",
        "tooltip": "輸出圖像的最大解析度。"
      },
      "prompt": {
        "name": "提示詞",
        "tooltip": "期望輸出內容的文字描述（最多 2000 字元）。「提示詞」或「參考圖像」至少需填寫一項。"
      },
      "reference_image": {
        "name": "參考圖像",
        "tooltip": "結果將採用此參考圖像的外觀（背景、光線、服裝）。「參考圖像」或「提示詞」至少需填寫一項。"
      },
      "seed": {
        "name": "種子",
        "tooltip": "種子控制此節點是否重新執行；無論種子為何，結果皆為非確定性。"
      }
    },
    "outputs": {
      "0": {
        "name": "圖像",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "Beeble 使用的 alpha 遮罩。「fill」模式下為空，無獨立遮罩。"
      }
    }
  },
