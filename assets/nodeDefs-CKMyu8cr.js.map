      },
      "y": {
        "name": "y",
        "tooltip": "在畫布上的初始垂直位置。"
      },
      "z_index": {
        "name": "z_index",
        "tooltip": "堆疊順序覆寫。圖層會依 z_index 穩定排序；相同值則依列表順序排列。"
      }
