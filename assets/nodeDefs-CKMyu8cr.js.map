      },
      "latent_idx": {
        "name": "latent_idx",
        "tooltip": "引導開始位置的 latent 影格索引，以 latent 影格而非像素影格計算。負值會將引導放置於 latent 起始位置之前的影格，而非從結尾往回計算。"
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "strength",
        "tooltip": "上限為 1.0。擴展後的引導會以負值去雜訊 mask 標記其填補位置，讓模型捨棄它們；超過 1.0 時，保留的位置也會變成負值，導致整個引導被捨棄。請改用 attention_mask 放大至超過 1.0。"
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
