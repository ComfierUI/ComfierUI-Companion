  "BakeAmbientOcclusion": {
    "description": "將高面數網格的環境遮蔽貼圖烘焙至低面數網格的 UV 配置（白色＝無遮蔽，深色＝縫隙）。請提供已展開 UV 的 low_poly，以及其減面來源的 high_poly。輸出供「將紋理套用至網格」的 occlusion 輸入使用的灰階影像（封裝至 ORM 貼圖 / occlusionTexture）。",
    "display_name": "烘焙環境遮蔽",
    "inputs": {
      "bias": {
        "name": "bias",
        "tooltip": "光線起點離開表面的偏移量，以邊界方塊對角線的比例表示。若平坦表面也出現深色斑點／孔洞，請提高。"
      },
      "high_poly": {
        "name": "high_poly"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "max_distance": {
        "name": "max_distance",
        "tooltip": "光線長度，以邊界方塊對角線的比例表示。較小＝較緊密、較局部的遮蔽。"
      },
      "resolution": {
        "name": "resolution"
      },
      "samples": {
        "name": "samples",
        "tooltip": "每個紋素的光線數。越多＝越平滑、越慢。有雜訊時請提高。"
      },
      "strength": {
        "name": "strength",
        "tooltip": "調整遮蔽強度。>1 變暗，<1 變亮。"
      }
    },
    "outputs": {
      "0": {
        "name": "occlusion",
        "tooltip": null
      }
    }
  },
  "BakeNormalMapFromMesh": {
    "description": "將高面數網格的切線空間法線貼圖（glTF/OpenGL +Y）烘焙至低面數網格的 UV 配置，擷取減面期間遺失的細節。請提供已展開 UV 的 low_poly，以及其減面來源的 high_poly。輸出供「將紋理套用至網格」的 normal_map 輸入使用的影像。",
    "display_name": "從網格烘焙法線貼圖",
    "inputs": {
      "cage_distance": {
        "name": "cage_distance",
        "tooltip": "表面搜尋範圍，以邊界方塊對角線的比例表示。大幅減面後出現錯誤或缺失區塊時請提高；若跨越間隙擷取到表面則降低。"
      },
      "high_poly": {
        "name": "high_poly"
      },
      "ignore_backfaces": {
        "name": "ignore_backfaces",
        "tooltip": "略過背向紋素的高面數表面，避免縫隙或封閉空間擷取到對側牆面。僅在 high_poly 的面繞序不一致時停用。"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "resolution": {
        "name": "resolution"
      }
    },
    "outputs": {
      "0": {
        "name": "normal_map",
        "tooltip": null
      }
    }
  },
  "BakeTextureFromVoxel": {
    "description": "在網格既有的 UV 配置上烘焙 PBR 紋理（對稀疏體素體積進行三線性取樣）。不會展開 UV——請在上游連接 UV 展開節點。輸出 base_color 與 metallic/roughness 灰階 IMAGE（若無 PBR 則為黑色）；將其提供給 ApplyTextureToMesh（相同網格）以供 SaveGLB 使用。",
    "display_name": "從體素烘焙紋理",
    "inputs": {
      "mesh": {
        "name": "mesh"
      },
      "reference_mesh": {
        "name": "參考網格",
        "tooltip": "可選的高密度、簡化前網格；會在取樣前將每個紋素反向投影至其實際表面，消除粗略網格上的稜面化烘焙效果。"
      },
      "texture_size": {
        "name": "texture_size",
        "tooltip": "方形 UV 圖集解析度。"
      },
      "voxel_colors": {
        "name": "voxel_colors"
      }
    },
    "outputs": {
      "0": {
        "name": "基礎顏色",
        "tooltip": null
      },
      "1": {
        "name": "金屬度",
        "tooltip": null
      },
      "2": {
        "name": "粗糙度",
        "tooltip": null
      }
    }
  },
