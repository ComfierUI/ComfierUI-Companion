      "guiding_latent": {
        "name": "guiding_latent",
        "tooltip": "引導 latent。其空間尺寸在兩個軸向上都必須以相同整數比例整除目標尺寸；相同尺寸會原樣固定，半尺寸會視為 x2 IC-LoRA 參考。"
      },
      "latent": {
        "name": "latent",
