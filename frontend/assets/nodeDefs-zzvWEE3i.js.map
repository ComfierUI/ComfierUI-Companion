  "SplatToMesh": {
    "description": "Estrai una mesh colorata da uno splat gaussiano.",
    "display_name": "Estrai Mesh da Splat",
    "inputs": {
      "color_sharpen": {
        "name": "affila_colore",
        "tooltip": "Rende più nitida la texture dei vertici: 1.0 = fusione fisicamente corretta; valori più alti spostano il colore di ogni voxel verso la sua gaussiana dominante invece di fare la media con i vicini (riduce la sfocatura della texture). Solo colore - la geometria non cambia."
      },
      "kernel": {
        "name": "kernel",
        "tooltip": "Massima semi-larghezza dello splat in voxel. Ogni gaussiana viene rasterizzata su una finestra dimensionata in base al suo 3-sigma, limitata qui - i surfel piccoli restano economici, quelli grandi non vengono troncati. Aumenta se gli splat sparsi lasciano dei vuoti."
      },
      "level": {
        "name": "livello",
        "tooltip": "Livello iso-superficie. Selezionato automaticamente da Otsu; questo lo modifica (1.0 = auto, più basso = superficie più spessa/connessa, più alto = più sottile/stretta)."
      },
      "min_component": {
        "name": "min_componente",
        "tooltip": "Elimina componenti connesse più piccole di questo numero di vertici (0 = mantieni tutte). Rimuove blob fluttuanti staccati e il guscio interno della doppia parete."
      },
      "min_opacity": {
        "name": "min_opacità",
        "tooltip": "Ignora gaussiane più deboli di questo valore prima della creazione della mesh."
      },
      "resolution": {
        "name": "risoluzione",
        "tooltip": "Risoluzione della griglia di densità lungo l'asse più lungo. Più alto = superficie più fine, più VRAM/tempo (crescita con risoluzione^3)."
      },
      "smooth": {
        "name": "smussa",
        "tooltip": "Iterazioni di smoothing mesh Taubin. Leviga la superficie senza ridurla (preserva il volume), a differenza della sfocatura della densità. 0 = superficie grezza."
      },
      "splat": {
        "name": "splat"
      }
    },
    "outputs": {
      "0": {
        "name": "mesh",
        "tooltip": null
      }
    }
  },
