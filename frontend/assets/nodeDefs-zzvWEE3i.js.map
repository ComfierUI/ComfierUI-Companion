  "LTXVAddGeneratedKeyframes": {
    "description": "Aggiunge fotogrammi chiave di dettaglio a un video latent. Ogni fotogramma chiave è un fotogramma latent di token la cui posizione RoPE copre un singolo fotogramma pixel; vengono denoised insieme al video e non fanno parte dell'output decodificato. Il posizionamento prevede uno slot ogni interval_frames pixel, ignorando fotogrammi I2V, guide esistenti e fotogrammi chiave di dettaglio già sul cond. I fotogrammi chiave collegati sono solo contenuto e vengono riposizionati su questa tela, a meno che non sia impostato frame_indices. Estraili di nuovo con LTXV Separate Generated Keyframes. Richiede un checkpoint addestrato per i fotogrammi chiave generati (che includa keyframes_abs_pos_embedding).",
    "display_name": "LTXV Aggiungi fotogrammi chiave generati",
    "inputs": {
      "frame_indices": {
        "name": "frame_indices",
        "tooltip": "Indici facoltativi dei fotogrammi pixel. Lascia vuoto per posizionare usando interval_frames sulla tela corrente. Quando impostata, questa lista determina il posizionamento (i fotogrammi chiave collegati vengono abbinati in ordine). L'ultimo fotogramma è consentito; il fotogramma 0 no (è già un token autonomo)."
      },
      "interval_frames": {
        "name": "interval_frames",
        "tooltip": "Passo in fotogrammi pixel per il posizionamento automatico. Il valore predefinito 24 corrisponde a circa un fotogramma chiave al secondo a 24 fps. I pixel occupati vengono ignorati. Ignorato quando è impostato frame_indices."
      },
      "keyframes": {
        "name": "keyframes",
        "tooltip": "Contenuto facoltativo con cui inizializzare i nuovi fotogrammi chiave. Collega i fotogrammi chiave di un precedente Separate (stesse dimensioni spaziali), oppure un video latent semplice per copiare il fotogramma più vicino in ogni nuovo slot (ad es. dopo un upscale temporale). Vengono comunque denoised e non fissati come guide. Gli indici registrati su un latent keyframes vengono ignorati salvo quando è impostato frame_indices. Ha effetto solo quando il campionamento inizia sotto sigma 1."
      },
      "latent": {
        "name": "latent",
        "tooltip": "Video latent 5D semplice accanto al quale generare i fotogrammi chiave. Aggiungili prima di Concat AV Latent."
      },
      "negative": {
        "name": "negative",
        "tooltip": "Condizionamento negativo a cui sono associati i fotogrammi chiave."
      },
      "positive": {
        "name": "positive",
        "tooltip": "Condizionamento positivo a cui sono associati i fotogrammi chiave."
      },
      "vae": {
        "name": "vae",
        "tooltip": "Usato solo per leggere i fattori di scala del latent."
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": "Condizionamento positivo con attenzione dei fotogrammi chiave generati associata."
      },
      "1": {
        "name": "negative",
        "tooltip": "Condizionamento negativo con attenzione dei fotogrammi chiave generati associata."
      },
      "2": {
        "name": "latent",
        "tooltip": "Video latent con fotogrammi chiave generati aggiunti su T."
      }
    }
  },
  "LTXVAddGuide": {
    "display_name": "LTXVAddGuide",
    "inputs": {
      "attention_mask": {
        "name": "attention_mask",
        "tooltip": "Maschera spaziale opzionale in pixel-space. Controlla l'influenza del condizionamento per regione tramite self-attention, moltiplicata per l'intensità."
      },
      "frame_idx": {
        "name": "indice_fotogramma",
        "tooltip": "Indice del fotogramma da cui iniziare il condizionamento. Per immagini a singolo fotogramma o video con 1-8 fotogrammi, qualsiasi valore di indice_fotogramma è accettabile. Per video con 9 o più fotogrammi, indice_fotogramma deve essere divisibile per 8, altrimenti verrà arrotondato per difetto al multiplo di 8 più vicino. I valori negativi sono contati dalla fine del video."
      },
      "iclora_parameters": {
        "name": "iclora_parameters",
        "tooltip": "Parametri IC-LoRA opzionali da un nodo Get IC-LoRA Parameters. Utilizzati per regolare l'elaborazione della guida come richiesto da alcuni IC-LoRA (ad es. quelli con reference_downscale_factor > 1). Quando concatenati, ogni LTXVAddGuide utilizza solo i parametri collegati ad esso."
      },
      "image": {
        "name": "immagine",
        "tooltip": "Immagine o video su cui condizionare il video latente. Deve avere un numero di fotogrammi pari a 8*n + 1. Se il video non ha 8*n + 1 fotogrammi, verrà tagliato al numero più vicino di 8*n + 1 fotogrammi."
      },
      "latent": {
        "name": "latente"
      },
      "negative": {
        "name": "negativo"
      },
      "positive": {
        "name": "positivo"
      },
      "strength": {
        "name": "intensità"
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "positivo",
        "tooltip": null
      },
      "1": {
        "name": "negativo",
        "tooltip": null
      },
      "2": {
        "name": "latente",
        "tooltip": null
      }
    }
  },
  "LTXVAddLatentGuide": {
    "description": "Fissa come guida un latent già codificato, per i casi in cui la guida provenga da una fase precedente anziché da un'immagine. Stesso effetto di LTXV Add Guide senza il ciclo di decodifica/codifica VAE. Una guida spazialmente più piccola della destinazione (un riferimento IC-LoRA o di dettaglio) viene dilatata su una griglia sparsa e le sue posizioni finali RoPE vengono espanse dello stesso rapporto, così da coprire la tela di destinazione anziché indirizzarne solo l'angolo superiore sinistro.",
    "display_name": "LTXV Aggiungi guida latent",
    "inputs": {
      "attention_mask": {
        "name": "attention_mask",
        "tooltip": "mask spaziale facoltativa nello spazio pixel. Controlla l'influenza del condizionamento per regione tramite self-attention, moltiplicata per strength."
      },
      "guiding_latent": {
        "name": "guiding_latent",
        "tooltip": "Latent della guida. La sua dimensione spaziale deve dividere quella della destinazione per lo stesso numero intero su entrambi gli assi; con dimensioni uguali viene fissato così com'è, mentre con dimensioni dimezzate viene trattato come riferimento IC-LoRA x2."
      },
      "latent": {
        "name": "latent",
        "tooltip": "Video latent di destinazione su cui viene fissata la guida."
      },
      "latent_idx": {
        "name": "latent_idx",
        "tooltip": "Indice del fotogramma latent da cui iniziare la guida, contato in fotogrammi latent anziché in fotogrammi pixel. I valori negativi posizionano la guida sui fotogrammi precedenti all'inizio del latent, senza contarli a ritroso dalla fine."
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "strength",
        "tooltip": "Limitato a 1.0. Una guida dilatata contrassegna le posizioni di padding con una mask di denoise negativa, affinché il modello le elimini; sopra 1.0 anche le posizioni mantenute diventerebbero negative e l'intera guida verrebbe eliminata. Amplifica oltre 1.0 usando invece attention_mask."
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "negative",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
