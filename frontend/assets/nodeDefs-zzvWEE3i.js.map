  "IdeogramPImage": {
    "description": "Genera immagini utilizzando P-Image, il modello text-to-image veloce di Ideogram. Tipografia avanzata e fotorealismo; supporta le didascalie strutturate JSON di Ideogram 4.0 per testo, colori e layout esatti.",
    "display_name": "Ideogram & Pruna P-Image",
    "inputs": {
      "aspect_ratio": {
        "name": "aspect_ratio",
        "tooltip": "Il rapporto d’aspetto per la generazione dell’immagine."
      },
      "control_after_generate": {
        "name": "control after generate"
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Prompt testuale. Accetta anche una didascalia strutturata JSON di Ideogram 4.0 (colori esatti come esadecimali #RRGGBB, stringhe di testo esatte, layout con bounding-box) — imposta prompt_upsampling su OFF per utilizzarla letteralmente."
      },
      "prompt_upsampling": {
        "name": "prompt_upsampling",
        "tooltip": "Espande prompt brevi in una didascalia strutturata dettagliata prima della generazione (il prompt riscritto viene restituito come final_prompt). Imposta su OFF quando fornisci la tua didascalia JSON o testo esatto."
      },
      "quality": {
        "name": "quality",
        "tooltip": "Livello di velocità/prezzo/qualità. MEDIUM è il valore predefinito per l’uso quotidiano; HIGH per prompt complessi, dettagli fini e testo difficile; VERY_LOW/LOW per bozze su larga scala. Il testo difficile viene reso male sotto MEDIUM."
      },
      "resolution": {
        "name": "resolution",
        "tooltip": "Classe di dimensione dell’output (i pixel esatti seguono il rapporto d’aspetto, ad es. 16:9 produce 1280x720 a 1K e 2560x1440 a 2K). Preferisci HIGH + 2K per una tipografia nitida."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed per una generazione riproducibile. Con prompt_upsampling su OFF, lo stesso seed e impostazioni restituiscono la stessa immagine; con ON/AUTO la riscrittura del prompt varia ad ogni esecuzione — riproduci un risultato riutilizzando il suo final_prompt con prompt_upsampling su OFF e lo stesso seed."
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      },
      "1": {
        "name": "final_prompt",
        "tooltip": "Il prompt da cui è stata effettivamente generata l’immagine (la didascalia strutturata riscritta se prompt_upsampling era attivo, altrimenti il tuo prompt). Riutilizzalo con prompt_upsampling su OFF e lo stesso seed per riprodurre questa immagine."
      }
    }
  },
