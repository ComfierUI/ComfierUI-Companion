  "BlockSparseAttention": {
    "description": "Applica l'attenzione sparsa a blocchi ai livelli di attenzione del modello idonei, riducendo il calcolo per le sequenze lunghe. Il guadagno di velocità aumenta con la lunghezza della sequenza, poiché le sequenze brevi sono generalmente più rapide con l'attenzione densa. Al di fuori di start/end_percent, nei dense_blocks e sotto min_tokens, il modello utilizza il backend di attenzione densa. Usa il nodo Backend di attenzione del modello per selezionare tale alternativa.",
    "display_name": "Attenzione sparsa del modello",
    "inputs": {
      "dense_blocks": {
        "name": "dense_blocks",
        "tooltip": "Blocchi transformer che vengono sempre eseguiti in modalità densa, ad es. '0, 1, 47-49'."
      },
      "end_percent": {
        "name": "end_percent",
        "tooltip": "Punto percentuale in cui termina l'attenzione sparsa. Dopo questo punto, l'attenzione torna densa."
      },
      "extra_tokens": {
        "name": "extra_tokens",
        "tooltip": "Token aggiuntivi con punteggio più alto a cui ogni blocco di query presta attenzione oltre ai blocchi selezionati. Più vicino alla modalità densa per un tempo di attenzione maggiore; consigliato 256, 0 disabilita. Ignorato per VSA."
      },
      "min_tokens": {
        "name": "min_tokens",
        "tooltip": "Le sequenze più corte di questo valore restano dense."
      },
      "model": {
        "name": "model",
        "tooltip": "Il modello da modificare."
      },
      "selection": {
        "name": "selection",
        "tooltip": "Metodo utilizzato per scegliere i blocchi chiave per l'attenzione completa a livello di token. sol-attn: Sparsifying Online Attention utilizza una soglia adattiva senza addestramento per ogni testa di attenzione e blocco di query. sla: Sparse-Linear Attention mantiene una percentuale fissa dei blocchi chiave con il punteggio più alto; utilizzare solo con pesi del modello addestrati per questo schema. vsa: Video Sparse Attention (FastVideo) utilizza la suddivisione 3D in cubi video e un ramo di attenzione grossolana appreso; richiede pesi del modello FastH3."
      },
      "selection_tau": {
        "name": "tau"
      },
      "sink_conditioning": {
        "name": "sink_conditioning",
        "tooltip": "Solo MiniMax-H3. exact_kv: ogni query presta attenzione esattamente alle righe compattate di testo/audio/riferimento (~3% del costo). exact_kv_and_rows: esegue inoltre in modalità densa le righe di query dell'audio di destinazione (mantiene intatto l'audio generato)."
      },
      "start_percent": {
        "name": "start_percent",
        "tooltip": "Punto percentuale in cui inizia l'attenzione sparsa. Prima di questo punto, l'attenzione rimane densa."
      },
      "verbose": {
        "name": "verbose",
        "tooltip": "Registra se ogni configurazione di attenzione ha utilizzato l'attenzione sparsa o perché è rimasta densa."
      }
    },
    "outputs": {
      "0": {
        "name": "model",
        "tooltip": "Il modello con attenzione sparsa a blocchi applicata."
      }
    }
  },
