  "LTXVGeneratedKeyframesToGuides": {
    "description": "Fissa i fotogrammi chiave generati in una fase precedente come guide immagine congelate su un canvas successivo. Vengono decodificati come singoli fotogrammi, ridimensionati se necessario e scritti con noise_mask=0 affinché non siano nuovamente sottoposti a denoising. Dopo un upscaling temporale, gli indici registrati vengono scalati dal canvas su cui sono stati generati a questo (negli stessi momenti). Usa override_frame_indices per impostare esplicitamente le posizioni. Per continuare a generare (e denoizzare) fotogrammi chiave in nuove posizioni, usa invece Aggiungi fotogrammi chiave generati.",
    "display_name": "LTXV Fotogrammi chiave generati in guide",
    "inputs": {
      "keyframes": {
        "name": "fotogrammi chiave",
        "tooltip": "L'output dei fotogrammi chiave di LTXV Separa fotogrammi chiave generati, che contiene l'indice del fotogramma pixel in cui ogni fotogramma chiave è stato generato."
      },
      "latent": {
        "name": "latent",
        "tooltip": "Il latent video di destinazione a cui aggiungere le guide, ad es. quello sottoposto a upscaling temporale."
      },
      "negative": {
        "name": "negativo"
      },
      "override_frame_indices": {
        "name": "override_frame_indices",
        "tooltip": "Facoltativo — fissa a questi fotogrammi pixel anziché alle posizioni registrate (o scalate automaticamente). Fornisci un indice per ogni fotogramma chiave. Lascia vuoto per riutilizzare le posizioni registrate o per scalarle quando il canvas di destinazione ha una lunghezza diversa, ad es. dopo un upscaling temporale x2."
      },
      "positive": {
        "name": "positivo"
      },
      "strength": {
        "name": "intensità",
        "tooltip": "Intensità della guida. 1.0 è un fissaggio rigido; valori inferiori la rendono meno rigida."
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "positivo",
        "tooltip": "Condizionamento positivo con i fotogrammi chiave fissati come guide immagine."
      },
      "1": {
        "name": "negativo",
        "tooltip": "Condizionamento negativo con i fotogrammi chiave fissati come guide immagine."
      },
      "2": {
        "name": "latent",
        "tooltip": "latent video di destinazione con i fotogrammi chiave aggiunti come guide congelate."
      }
    }
  },
