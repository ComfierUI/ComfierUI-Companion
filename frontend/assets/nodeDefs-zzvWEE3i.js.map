      },
      "context_length": {
        "name": "lunghezza contesto",
        "tooltip": "La lunghezza della finestra di contesto."
      },
      "context_overlap": {
        "name": "sovrapposizione contesto",
        "tooltip": "La sovrapposizione della finestra di contesto."
      },
      "context_schedule": {
        "name": "pianificazione contesto",
        "tooltip": "Algoritmo di pianificazione dipendente dal passo per le finestre di contesto."
      },
      "context_stride": {
        "name": "passo contesto",
        "tooltip": "Il passo della finestra di contesto; applicabile solo a pianificazioni uniformi."
      },
      "dim": {
        "name": "dimensione",
        "tooltip": "La dimensione a cui applicare le finestre di contesto."
      },
      "freenoise": {
        "name": "freenoise",
        "tooltip": "Se applicare la miscelazione del rumore FreeNoise, migliora la fusione delle finestre."
      },
      "fuse_method": {
        "name": "metodo di fusione",
        "tooltip": "Il metodo da utilizzare per fondere le finestre di contesto."
      },
      "latent_retain_index_list": {
        "name": "lista indici latenti da mantenere",
        "tooltip": "Elenco degli indici latenti da mantenere direttamente nel rumore latente per ogni finestra. Da usare per workflow dove il contenuto di riferimento (es. un'immagine iniziale) si trova direttamente nel rumore latente invece che in canali di condizionamento separati (es. I2V in stile inplace come LTXV, AnimateDiff). Indipendente da cond_retain_index_list."
