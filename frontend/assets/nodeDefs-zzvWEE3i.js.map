  "AddLayer": {
    "display_name": "Aggiungi livello",
    "inputs": {
      "blend_mode": {
        "name": "modalità di fusione",
        "tooltip": "Modalità di fusione iniziale."
      },
      "flip_h": {
        "name": "ribalta_orizzontale",
        "tooltip": "Ribalta il livello orizzontalmente."
      },
      "flip_v": {
        "name": "ribalta_verticale",
        "tooltip": "Ribalta il livello verticalmente."
      },
      "height": {
        "name": "altezza",
        "tooltip": "Altezza di visualizzazione iniziale. 0 mantiene l'altezza originale dell'immagine."
      },
      "image": {
        "name": "immagine",
        "tooltip": "Contenuto del livello alla sua dimensione originale. Un batch si espande in livelli consecutivi."
      },
      "layers": {
        "name": "livelli",
        "tooltip": "Stack di livelli a cui aggiungere. Lasciare scollegato per iniziare un nuovo stack."
      },
      "mask": {
        "name": "maschera",
        "tooltip": "Maschera di trasparenza per questo livello. Le aree mascherate (valore 1) diventano trasparenti, moltiplicandosi con qualsiasi canale alfa già presente nell'immagine."
      },
      "name": {
        "name": "nome",
        "tooltip": "Nome del livello mostrato nell'editor del compositore."
      },
      "opacity": {
        "name": "opacità",
        "tooltip": "Opacità iniziale del livello."
      },
      "rotation": {
        "name": "rotazione",
        "tooltip": "Rotazione iniziale in gradi, in senso orario."
      },
      "width": {
        "name": "larghezza",
        "tooltip": "Larghezza di visualizzazione iniziale. 0 mantiene la larghezza originale dell'immagine."
      },
      "x": {
        "name": "x",
        "tooltip": "Posizionamento orizzontale iniziale sulla tela."
      },
      "y": {
        "name": "y",
        "tooltip": "Posizionamento verticale iniziale sulla tela."
      },
      "z_index": {
        "name": "z_index",
        "tooltip": "Sovrascrittura dello stacking. I livelli sono ordinati stabilmente per z_index; valori uguali mantengono l'ordine della lista."
      }
    },
    "outputs": {
      "0": {
        "tooltip": "Lo stack di livelli con questo livello aggiunto."
      }
    }
  },
