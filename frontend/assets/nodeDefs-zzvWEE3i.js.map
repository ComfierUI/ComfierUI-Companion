      },
      "resize_method": {
        "name": "metodo_ridimensionamento",
        "tooltip": "upper_bound_resize: scala in modo che il lato più lungo = risoluzione (limita la memoria, predefinito).\nlower_bound_resize: scala in modo che il lato più corto = risoluzione (preserva più dettagli su immagini alte/larghe, usa più memoria)."
      },
      "resolution": {
        "name": "risoluzione",
        "tooltip": "Risoluzione a cui il modello viene eseguito (lato più lungo, multiplo di 14).\nPiù bassa = più veloce / meno VRAM.\nPiù alta = più dettaglio.\nL'output viene ricampionato alla dimensione originale."
      }
    },
    "outputs": {
      "0": {
        "name": "da3_geometry",
        "tooltip": "Dizionario di tensori non normalizzati.\nContiene sempre le chiavi: depth, image, mode.\nChiavi opzionali: sky (per Mono/Metric), confidence (per Small/Base), extrinsics + intrinsics (per multi-view)."
      }
    }
