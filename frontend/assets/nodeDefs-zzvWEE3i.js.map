  "RunwayAleph2VideoToVideoNode": {
    "description": "Modifica un video con un prompt testuale utilizzando il modello Aleph2 di Runway. Aleph2 trasforma il tuo filmato (restyling, nuova illuminazione, aggiunta o rimozione di elementi, cambio del punto di vista) mantenendo il movimento e il timing originali; la risoluzione di output corrisponde a quella del video di input, che deve essere di 2-30 secondi a 30 fps o meno. Puoi guidare la modifica opzionalmente con keyframe (ancorati al video di input) o immagini prompt (ancorate al video di output) - usa uno o l'altro, non entrambi.",
    "display_name": "Runway Aleph2 Video to Video",
    "inputs": {
      "control_after_generate": {
        "name": "control after generate"
      },
      "keyframes": {
        "name": "keyframes",
        "tooltip": "Immagini guida ancorate al video di input, da nodi Aleph2 Keyframe (fino a 5). Usa keyframe o immagini prompt, non entrambi."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Descrive cosa dovrebbe apparire nell'output (1-1000 caratteri)."
      },
      "prompt_images": {
        "name": "prompt_images",
        "tooltip": "Immagini guida ancorate al video di output, da nodi Aleph2 Prompt Image (fino a 5). Usa keyframe o immagini prompt, non entrambi."
      },
      "public_figure_threshold": {
        "name": "public_figure_threshold",
        "tooltip": "Moderazione dei contenuti per figure pubbliche riconoscibili."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed casuale per la generazione"
      },
      "video": {
        "name": "video",
        "tooltip": "Video di input da modificare. Deve essere di 2-30 secondi a 30 fps o meno."
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      }
    }
  },
