  "BeebleSwitchXImageEdit": {
    "description": "Modifica una singola immagine con Beeble SwitchX. Cambia qualsiasi elemento della scena (sfondo, illuminazione, costume) mantenendo i pixel originali del soggetto. Fornisci un'immagine di riferimento e/o un prompt testuale per descrivere il nuovo aspetto. Max ~2,77MP.",
    "display_name": "Beeble SwitchX Modifica Immagine",
    "inputs": {
      "alpha_mode": {
        "name": "modalità alpha",
        "tooltip": "Controlla come SwitchX decide cosa mantenere e cosa rigenerare. 'auto' isola automaticamente il soggetto principale. 'fill' rigenera l'intero fotogramma mantenendo la geometria. 'select' propaga un keyframe del primo fotogramma su tutta la clip. 'custom' utilizza una maschera alpha per fotogramma fornita da te."
      },
      "control_after_generate": {
        "name": "controllo dopo la generazione"
      },
      "image": {
        "name": "immagine"
      },
      "max_resolution": {
        "name": "risoluzione massima",
        "tooltip": "Risoluzione massima di output."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Descrizione testuale del risultato desiderato (max 2000 caratteri). È richiesto almeno uno tra 'prompt' o 'reference_image'."
      },
      "reference_image": {
        "name": "immagine di riferimento",
        "tooltip": "Immagine di riferimento di cui il risultato dovrebbe adottare l'aspetto (sfondo, illuminazione, costume). È richiesto almeno uno tra 'reference_image' o 'prompt'."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Il seed controlla se il nodo deve essere rieseguito; i risultati sono non deterministici indipendentemente dal seed."
      }
    },
    "outputs": {
      "0": {
        "name": "immagine",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "La maschera alpha utilizzata da Beeble. Vuota in modalità 'fill', che non ha una maschera separata."
      }
    }
  },
  "BeebleSwitchXVideoEdit": {
    "description": "Modifica un video con Beeble SwitchX. Cambia qualsiasi elemento della scena (sfondo, illuminazione, costume) mantenendo i pixel e il movimento originali del soggetto. Fornisci un'immagine di riferimento e/o un prompt testuale per descrivere il nuovo aspetto. Max 240 fotogrammi, max ~2,77MP per fotogramma.",
    "display_name": "Beeble SwitchX Modifica Video",
    "inputs": {
      "alpha_mode": {
        "name": "modalità alpha",
        "tooltip": "Controlla come SwitchX decide cosa mantenere e cosa rigenerare. 'auto' isola automaticamente il soggetto principale. 'fill' rigenera l'intero fotogramma mantenendo la geometria. 'select' propaga un keyframe del primo fotogramma su tutta la clip. 'custom' utilizza una maschera alpha per fotogramma fornita da te."
      },
      "control_after_generate": {
        "name": "controllo dopo la generazione"
      },
      "max_resolution": {
        "name": "risoluzione massima",
        "tooltip": "Risoluzione massima di output."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Descrizione testuale del risultato desiderato (max 2000 caratteri). È richiesto almeno uno tra 'prompt' o 'reference_image'."
      },
      "reference_image": {
        "name": "immagine di riferimento",
        "tooltip": "Immagine di riferimento di cui il risultato dovrebbe adottare l'aspetto (sfondo, illuminazione, costume). È richiesto almeno uno tra 'reference_image' o 'prompt'."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Il seed controlla se il nodo deve essere rieseguito; i risultati sono non deterministici indipendentemente dal seed."
      },
      "video": {
        "name": "video"
      }
    },
    "outputs": {
      "0": {
        "name": "video",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "La maschera alpha utilizzata da Beeble. Vuota in modalità 'fill', che non ha una maschera separata."
      }
    }
  },
  "BerniniConditioning": {
    "description": "Nodo di conditioning per Bernini per il conditioning contestuale di video/immagini. Può essere utilizzato per i seguenti compiti: t2v (testo-a-video), v2v (video-a-video), rv2v (editing video guidato da riferimento), r2v (riferimento-a-video), ads2v (inserisci immagine/video in un video). Le immagini di riferimento iniettate come token contestuali (r2v, rv2v) vengono codificate indipendentemente con il proprio rapporto d'aspetto nativo (lato lungo limitato da ref_max_size)",
    "display_name": "Bernini Conditioning",
    "inputs": {
      "batch_size": {
        "name": "batch_size"
      },
      "height": {
        "name": "altezza"
      },
      "length": {
        "name": "lunghezza"
      },
      "negative": {
        "name": "negativo"
      },
      "positive": {
        "name": "positivo"
      },
      "ref_max_size": {
        "name": "ref_max_size",
        "tooltip": "Dimensione massima per il lato lungo di reference_video e reference_images. Ridimensionato mantenendo il rapporto d'aspetto e arrotondato a 16px."
      },
      "reference_images": {
        "name": "immagini_di_riferimento"
      },
      "reference_video": {
        "name": "video_di_riferimento",
        "tooltip": "Video da inserire nel video sorgente (ads2v)."
      },
      "source_video": {
        "name": "video_sorgente",
        "tooltip": "Video sorgente da modificare o restilizzare (v2v, rv2v). Ridimensionato a larghezza/altezza e tagliato a lunghezza."
      },
      "vae": {
        "name": "vae"
      },
      "width": {
        "name": "larghezza"
      }
    },
    "outputs": {
      "0": {
        "name": "positivo",
        "tooltip": null
      },
      "1": {
        "name": "negativo",
        "tooltip": null
      },
      "2": {
        "name": "latente",
