  "ByteDanceSeedreamLayerSeparationNode": {
    "description": "Scomponi un'immagine in una base di sfondo più fino a 16 livelli trasparenti riposizionabili, ciascuno con ordine di sovrapposizione, riquadro di delimitazione, nome e descrizione.",
    "display_name": "ByteDance Seedream 5.0 Pro Separazione livelli (legacy)",
    "inputs": {
      "control_after_generate": {
        "name": "controllo dopo generazione"
      },
      "crop_layers": {
        "name": "ritaglia_livelli",
        "tooltip": "Geometria dei batch di output dei livelli/maschere (layer_stack non è influenzato e resta sempre aderente). Canvas intero: ogni livello su una tela base alla posizione del suo riquadro di delimitazione - ricomponi direttamente con ImageCompositeMasked. Dimensione minima: ogni livello ritagliato al suo riquadro di delimitazione (padded al livello più grande per il batch) - tensori molto più piccoli; ricostruisci la posizione con Layers From Bounding Boxes usando l'output bboxes."
      },
      "image": {
        "name": "immagine",
        "tooltip": "L'immagine da separare. Esattamente una immagine, almeno 512x512 pixel, rapporto d'aspetto tra 1:16 e 16:1. Gli input superiori a circa 4MP vengono ridimensionati prima del caricamento."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Come separare l'immagine. Lascia vuoto per rilevare automaticamente e separare tutti gli elementi principali. Descrivi gli elementi in linguaggio naturale per controllare la separazione, oppure indica regioni esatte con i tag <bbox>left top right bottom</bbox> (coordinate per-mille da 0 a 1000)."
      },
      "prompt_optimization": {
        "name": "ottimizzazione_prompt",
        "tooltip": "Modalità di ottimizzazione del prompt: 'standard' offre qualità superiore, 'fast' tempi di generazione più brevi."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed da utilizzare per la generazione."
      },
      "size": {
        "name": "dimensione",
        "tooltip": "Livello di risoluzione in output. 'auto' segue la dimensione dell'immagine di input (limitata nell'intervallo 1K-2K)."
      },
      "watermark": {
        "name": "filigrana",
        "tooltip": "Se aggiungere una filigrana \"AI generated\" alle immagini."
      }
    },
    "outputs": {
      "0": {
        "name": "immagine_base",
        "tooltip": "L'immagine di base (sfondo) su cui si sovrappongono i livelli."
      },
      "1": {
        "name": "maschera_base",
        "tooltip": "Trasparenza dell'immagine di base (1 = trasparente, convenzione LoadImage); attualmente sempre completamente opaca."
      },
      "2": {
        "name": "livelli",
        "tooltip": "Livelli trasparenti ordinati dal basso verso l'alto. Modalità canvas intero: posizionati su una tela base nera alla posizione del loro riquadro di delimitazione. Modalità dimensione minima: ritagliati al loro riquadro di delimitazione, ancorati in alto a sinistra, padded al livello più grande."
      },
      "3": {
        "name": "maschere",
        "tooltip": "Trasparenza per livello, indicizzata come il batch dei livelli (1 = trasparente, convenzione LoadImage). Per compositing in stile ImageCompositeMasked, aggiungi prima InvertMask."
      },
      "4": {
        "name": "riquadri",
        "tooltip": "Un riquadro di posizionamento per livello, indicizzato come il batch dei livelli (fornisci entrambi, più maschere, a Layers From Bounding Boxes per ricostruire il posizionamento per livello): {x, y, width, height, metadata: {name, desc, z_index, native_size, content_rect, flags}}. content_rect = [left, top, width, height] è la regione di contenuto del livello all'interno del proprio frame; viene posizionato sulla tela alla posizione del riquadro più quell'offset."
      },
      "5": {
        "name": "layer_stack",
        "tooltip": "Documento livelli pronto per la modifica per Create Layered Image: la base più ogni elemento come proprio livello nominato, ritagliato stretto, alla sua vera posizione e ordine di sovrapposizione. Collega direttamente, oppure estendi con Add Layer."
      }
    }
  },
