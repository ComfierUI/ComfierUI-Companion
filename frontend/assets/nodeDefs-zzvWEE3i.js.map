  "RenderSplat": {
    "description": "Renderizza uno splat gaussiano come immagine con un rasterizzatore EWA anisotropico (splat ellittici orientati, antialiasing, ordinamento in profondità dal fronte al retro). La fotocamera proviene da un input camera_info (Carica / Anteprima 3D, o un nodo Crea Camera Info); lascia vuoto per inquadrare automaticamente lo splat. Imposta frames maggiore di 1 per una sequenza turntable di immagini da utilizzare in un nodo Video.",
    "display_name": "Render Splat",
    "inputs": {
      "background": {
        "name": "sfondo"
      },
      "bg_image": {
        "name": "immagine_sfondo",
        "tooltip": "Immagine di sfondo opzionale compositata dietro lo splat (sovrascrive il colore di sfondo solido). Ridimensionata alla dimensione di rendering; una sequenza viene usata per fotogramma, una singola immagine per tutti. Solo per color/clay."
      },
      "camera_info": {
        "name": "camera_info",
        "tooltip": "Fotocamera da cui effettuare il rendering - una fotocamera Load3D / Preview3D o un nodo Crea Camera Info. Se vuoto, lo splat viene inquadrato automaticamente da una vista 3/4 predefinita."
      },
      "frames": {
        "name": "fotogrammi",
        "tooltip": "-1, 0, 1 = singola immagine statica; >1 = turntable, la fotocamera ruota su un giro completo di 360° (funziona con qualsiasi camera_info). Un valore negativo ruota nell'altra direzione."
      },
      "headlight_shading": {
        "name": "ombreggiatura_faro",
        "tooltip": "Ombreggiatura diffusa da una luce sulla fotocamera (faro), usando le normali dei surfel dello splat: scurisce le superfici che si allontanano dalla vista per rivelare forma/curvatura. 0 = albedo piatto, 1 = ombreggiatura massima."
      },
      "height": {
        "name": "altezza"
      },
      "opacity_threshold": {
        "name": "soglia_opacità",
        "tooltip": "Elimina i gaussiani con opacità inferiore a questo valore (rimuove elementi deboli/fluttuanti)."
      },
      "render_style": {
        "name": "stile_render",
        "tooltip": "Cosa mostra l'immagine in output: colore, clay (ombreggiatura neutra), profondità (vicino=chiaro), normale (mappa normale OpenGL)."
      },
      "sharpen": {
        "name": "nitidezza",
        "tooltip": "Aumenta la nitidezza degli splat sovrapposti: 1.0 = fusione fisicamente corretta; valori più alti accentuano ogni pixel verso lo splat dominante (più vicino) per una texture più nitida, senza ridurre gli splat o creare spazi vuoti. Sopra 1 non è fisico."
      },
      "splat": {
        "name": "splat"
      },
      "splat_scale": {
        "name": "scala_splat",
        "tooltip": "Moltiplicatore sull'impronta proiettata di ogni splat (più basso = punti più nitidi, più alto = superficie più morbida/piena)."
      },
      "width": {
        "name": "larghezza"
      }
    },
    "outputs": {
      "0": {
        "name": "immagine",
        "tooltip": null
      },
      "1": {
        "name": "mask",
        "tooltip": null
      }
    }
