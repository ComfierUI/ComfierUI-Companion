  "RemeshMesh": {
    "description": "Riestrae una mesh uniformemente tassellata tramite un campo di distanza a banda stretta + Dual Contouring, sul dispositivo di calcolo attivo. Normalizza topologie disordinate / non manifold / auto-intersecanti; esegui prima di Decimate Mesh per ottenere un numero esatto di facce. L'output rimane saldato.",
    "display_name": "Rigenera mesh (DC a banda stretta)",
    "inputs": {
      "band": {
        "name": "band",
        "tooltip": "Larghezza della banda stretta in unità voxel. In modalità UDF sposta anche la superficie."
      },
      "drop_small_components": {
        "name": "drop_small_components",
        "tooltip": "Scarta le componenti al di sotto di questa frazione del conteggio delle facce della più grande. 0 disabilita."
      },
      "fix_poles": {
        "name": "fix_poles",
        "tooltip": "Comprimi le coppie di vertici di valenza 3 (artefatto di giunzione a T DC)."
      },
      "mesh": {
        "name": "mesh"
      },
      "precluster_max_verts": {
        "name": "precluster_max_verts",
        "tooltip": "Limita il numero di vertici di input prima delle interrogazioni del campo; gli input superiori vengono prima decimati tramite clustering fino a questo valore. Evita OOM su mesh enormi."
      },
      "project_back": {
        "name": "project_back",
        "tooltip": "Interpola linearmente i vertici verso la superficie originale (0 = DC puro, 1 = agganciati)."
      },
      "resolution": {
        "name": "risoluzione",
        "tooltip": "Risoluzione della griglia voxel (densità di output). 256 ~ 100k facce, 512 ~ 1M. Per un numero esatto di facce, usa poi Decimate Mesh."
      },
      "sign_mode": {
        "name": "sign_mode",
        "tooltip": "udf: robusto con input disordinati/non manifold. sdf: superficie singola pulita con recupero di caratteristiche nette QEF (Quadratic Error Function), ma richiede un orientamento coerente."
      },
      "sign_mode_drop_enclosed_components": {
        "name": "drop_enclosed_components"
      },
      "sign_mode_drop_inverted_components": {
        "name": "drop_inverted_components"
      },
      "sign_mode_qef": {
        "name": "qef"
      },
      "smooth_iters": {
        "name": "smooth_iters",
        "tooltip": "Iterazioni di smussamento Taubin (0 = disattivato). 2-3 elimina gli artefatti DC a gradini; valori superiori smussano eccessivamente i bordi QEF."
      }
