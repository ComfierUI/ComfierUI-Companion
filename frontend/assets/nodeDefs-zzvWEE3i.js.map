  "BakeAmbientOcclusion": {
    "description": "Esegue il baking di una mappa di occlusione ambientale da una mesh high-poly nella mappatura UV di una low-poly (bianco = aperto, scuro = cavità). Fornisci la low_poly con UV unwrapped e la high_poly da cui è stata decimata. Produce un'immagine in scala di grigi per l'ingresso occlusion di Applica texture alla mesh (inclusa nella mappa ORM / occlusionTexture).",
    "display_name": "Baking dell'occlusione ambientale",
    "inputs": {
      "bias": {
        "name": "bias",
        "tooltip": "Sollevamento dell'origine dei raggi dalla superficie, come frazione della diagonale del bounding box. Aumenta se anche le superfici uniformi mostrano macchie/scanalature scure."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "max_distance": {
        "name": "max_distance",
        "tooltip": "Lunghezza dei raggi, come frazione della diagonale del bounding box. Minore = occlusione più stretta e locale."
      },
      "resolution": {
        "name": "resolution"
      },
      "samples": {
        "name": "samples",
        "tooltip": "Raggi per texel. Più = più uniforme, più lento. Aumenta se granuloso."
      },
      "strength": {
        "name": "strength",
        "tooltip": "Scala l'occlusione. >1 scurisce, <1 schiarisce."
      }
    },
    "outputs": {
      "0": {
        "name": "occlusion",
        "tooltip": null
      }
    }
  },
  "BakeNormalMapFromMesh": {
    "description": "Esegue il baking di una normal map nello spazio tangente (glTF/OpenGL +Y) da una mesh high-poly nella mappatura UV di una low-poly, catturando i dettagli persi durante la decimazione. Fornisci la low_poly con UV unwrapped e la high_poly da cui è stata decimata. Produce un'immagine per l'ingresso normal_map di Applica texture alla mesh.",
    "display_name": "Baking della normal map dalla mesh",
    "inputs": {
      "cage_distance": {
        "name": "cage_distance",
        "tooltip": "Fascia di ricerca della superficie, come frazione della diagonale del bounding box. Aumenta in caso di aree errate/mancanti con forte decimazione; riduci se acquisisce superfici oltre le separazioni."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "ignore_backfaces": {
        "name": "ignore_backfaces",
        "tooltip": "Ignora le superfici high-poly rivolte lontano dal texel, affinché cavità/spazi chiusi non acquisiscano la parete opposta. Disabilita solo se l'orientamento della high-poly non è coerente."
      },
      "low_poly": {
        "name": "low_poly"
      },
      "resolution": {
        "name": "resolution"
      }
    },
    "outputs": {
      "0": {
        "name": "normal_map",
        "tooltip": null
      }
    }
  },
  "BakeTextureFromVoxel": {
    "description": "Esegue il baking delle texture PBR nella mappatura UV esistente della mesh (campionamento trilineare del volume voxel sparso). NON esegue l'unwrapping: collega a monte un nodo di unwrapping UV. Produce IMAGE base_color e IMAGE in scala di grigi metallic/roughness (nere se non è presente PBR); forniscile ad Applica texture alla mesh (la STESSA mesh) per SaveGLB.",
    "display_name": "Baking della texture dal voxel",
    "inputs": {
      "mesh": {
        "name": "mesh"
      },
      "reference_mesh": {
        "name": "reference_mesh",
        "tooltip": "Mesh densa opzionale precedente alla decimazione; riproietta ogni texel sulla sua superficie reale prima del campionamento, eliminando il baking sfaccettato sulle mesh grossolane."
      },
      "texture_size": {
        "name": "texture_size",
        "tooltip": "Risoluzione dell'atlante UV quadrato."
      },
      "voxel_colors": {
        "name": "voxel_colors"
      }
    },
    "outputs": {
      "0": {
        "name": "base_color",
        "tooltip": null
      },
      "1": {
        "name": "metallic",
        "tooltip": null
      },
      "2": {
        "name": "roughness",
        "tooltip": null
      }
    }
  },
