      },
      "reference_image": {
        "name": "image de référence",
        "tooltip": "Image de référence dont l’apparence (arrière-plan, éclairage, costume) doit être adoptée par le résultat. Au moins l’un des champs « image de référence » ou « invite » est requis."
      },
      "seed": {
        "name": "graine",
