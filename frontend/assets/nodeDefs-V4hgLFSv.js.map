  "LTXVAddGeneratedKeyframes": {
    "description": "Ajoute des images clés de détail à un latent vidéo. Chaque image clé correspond à une image latent de jetons dont la position RoPE couvre une seule image en pixels ; elles sont débruitées avec la vidéo et ne font pas partie de la sortie décodée. Le placement s'effectue à un emplacement tous les interval_frames pixels, en ignorant les images I2V, les guides existants et les images clés de détail déjà présentes sur le cond. Les images clés connectées ne fournissent que le contenu et sont replacées sur ce canevas, sauf si frame_indices est défini. Récupérez-les avec LTXV Separate Generated Keyframes. Nécessite un checkpoint entraîné pour les images clés générées (contenant keyframes_abs_pos_embedding).",
    "display_name": "LTXV Ajouter des images clés générées",
    "inputs": {
      "frame_indices": {
        "name": "frame_indices",
        "tooltip": "Indices facultatifs d'images en pixels. Laissez vide pour placer selon interval_frames sur le canevas actuel. Lorsqu'elle est définie, cette liste indique le placement (les images clés connectées sont associées dans l'ordre). La dernière image est autorisée ; l'image 0 ne l'est pas (c'est déjà un jeton autonome)."
      },
      "interval_frames": {
        "name": "interval_frames",
        "tooltip": "Pas d'images en pixels pour le placement automatique. La valeur par défaut de 24 correspond à environ une image clé par seconde à 24 fps. Les pixels occupés sont ignorés. Ignoré lorsque frame_indices est défini."
      },
      "keyframes": {
        "name": "keyframes",
        "tooltip": "Contenu facultatif pour initialiser les nouvelles images clés. Connectez des images clés provenant d'un Separate antérieur (de même taille spatiale), ou un latent vidéo simple pour copier l'image la plus proche à chaque nouvel emplacement (par ex. après un upscale temporel). Elles sont toujours débruitées, et non fixées comme guides. Les indices enregistrés sur un latent d'images clés sont ignorés sauf si frame_indices est défini. N'a d'effet que si l'échantillonnage commence en dessous de sigma 1."
      },
      "latent": {
        "name": "latent",
        "tooltip": "latent vidéo 5D simple avec lequel générer des images clés. Ajoutez-les avant Concat AV Latent."
      },
      "negative": {
        "name": "negative",
        "tooltip": "Conditionnement négatif auquel les images clés sont attachées."
      },
      "positive": {
        "name": "positive",
        "tooltip": "Conditionnement positif auquel les images clés sont attachées."
      },
      "vae": {
        "name": "vae",
        "tooltip": "Utilisé uniquement pour lire les facteurs d'échelle du latent."
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": "Conditionnement positif avec l'attention des images clés générées attachée."
      },
      "1": {
        "name": "negative",
        "tooltip": "Conditionnement négatif avec l'attention des images clés générées attachée."
      },
      "2": {
        "name": "latent",
        "tooltip": "latent vidéo avec des images clés générées ajoutées sur T."
      }
    }
  },
  "LTXVAddGuide": {
    "display_name": "LTXVAddGuide",
    "inputs": {
      "attention_mask": {
        "name": "attention_mask",
        "tooltip": "Masque spatial optionnel dans l’espace pixel. Contrôle l’influence du conditionnement par région via l’auto-attention, multipliée par la force."
      },
      "frame_idx": {
        "name": "indice_de_l'image",
        "tooltip": "Indice de l'image pour commencer le conditionnement. Pour les images uniques ou les vidéos de 1 à 8 images, toute valeur d'indice de l'image est acceptable. Pour les vidéos de 9 images ou plus, l'indice de l'image doit être divisible par 8, sinon il sera arrondi à la baisse au multiple de 8 le plus proche. Les valeurs négatives sont comptées à partir de la fin de la vidéo."
      },
      "iclora_parameters": {
        "name": "iclora_parameters",
        "tooltip": "Paramètres IC-LoRA optionnels provenant d’un nœud Get IC-LoRA Parameters. Utilisé pour ajuster le traitement des guides selon les besoins de certains IC-LoRA (ex. ceux avec un reference_downscale_factor > 1). Lorsqu’ils sont chaînés, chaque LTXVAddGuide utilise uniquement les paramètres qui lui sont connectés."
      },
      "image": {
        "name": "image",
        "tooltip": "Image ou vidéo pour conditionner la vidéo latente. Doit être 8*n + 1 images. Si la vidéo n'est pas 8*n + 1 images, elle sera coupée au plus proche 8*n + 1 images."
      },
      "latent": {
        "name": "latent"
      },
      "negative": {
        "name": "négatif"
      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "force"
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "négatif",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
  "LTXVAddLatentGuide": {
    "description": "Fixe un latent déjà encodé comme guide, lorsque le guide provient d'une étape antérieure plutôt que d'une image. Même effet que LTXV Add Guide sans aller-retour de décodage/encodage vae. Un guide spatialement plus petit que la cible (une référence IC-LoRA ou de détail) est dilaté sur une grille clairsemée, et ses positions finales RoPE sont étendues selon le même rapport afin qu'il couvre le canevas cible au lieu de n'adresser que son coin supérieur gauche.",
    "display_name": "LTXV Ajouter un guide latent",
    "inputs": {
      "attention_mask": {
        "name": "attention_mask",
        "tooltip": "masque spatial facultatif dans l'espace pixel. Contrôle l'influence du conditionnement par région via l'auto-attention, multipliée par strength."
      },
      "guiding_latent": {
        "name": "guiding_latent",
        "tooltip": "latent du guide. Sa taille spatiale doit diviser celle de la cible par le même nombre entier sur les deux axes ; une taille égale le fixe tel quel, une demi-taille est traitée comme une référence IC-LoRA x2."
      },
      "latent": {
        "name": "latent",
        "tooltip": "latent vidéo cible sur lequel le guide est fixé."
      },
      "latent_idx": {
        "name": "latent_idx",
        "tooltip": "Indice d'image latent où commencer le guide, compté en images latentes plutôt qu'en images en pixels. Les valeurs négatives placent le guide sur des images antérieures au début du latent, et ne sont pas comptées à rebours depuis sa fin."
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "strength": {
        "name": "strength",
        "tooltip": "Limité à 1.0. Un guide dilaté marque ses positions de remplissage avec un masque de débruitage négatif afin que le modèle les abandonne ; au-dessus de 1.0, les positions conservées deviendraient elles aussi négatives et l'intégralité du guide serait abandonnée. Amplifiez au-delà de 1.0 avec attention_mask à la place."
      },
      "vae": {
        "name": "vae"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "negative",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
