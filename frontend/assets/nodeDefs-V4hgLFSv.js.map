  "LayersFromBoundingBoxes": {
    "description": "Transformez un lot d’images et ses boîtes englobantes en une pile de couches, une couche par image, chacune placée selon sa propre boîte. Utilisez ceci lorsqu’un nœud émet des couches sous forme de lot – un lot transporte un seul placement pour chaque image, donc les positions individuelles seraient autrement perdues.",
    "display_name": "Couches à partir de boîtes englobantes",
    "inputs": {
      "bboxes": {
        "name": "bboxes",
        "tooltip": "Boîtes de placement, alignées par index avec le lot d’images. Accepte des boîtes englobantes (x, y, largeur, hauteur), des éléments normalisés (avec un 'bbox' – ceux-ci nécessitent canvas_width/canvas_height pour être convertis en pixels), ou une chaîne JSON de l’un ou l’autre. Les images sans boîte correspondante sont placées à l’origine. La largeur/hauteur d’une boîte redimensionne la couche pour l’adapter. metadata.name (ou desc) et metadata.z_index sont utilisés si présents, et metadata.content_rect (relatif à l’image) recadre l’image à son contenu réel."
      },
      "canvas_height": {
        "name": "canvas_height",
        "tooltip": "Hauteur du canevas du document. 0 la déduit des couches placées."
      },
      "canvas_width": {
        "name": "canvas_width",
        "tooltip": "Largeur du canevas du document. 0 la déduit des couches placées."
      },
      "crop_to_content": {
        "name": "crop_to_content",
        "tooltip": "Recadre chaque image selon metadata.content_rect si présent et place le contenu à la position de la boîte plus le décalage du rectangle. Laissez activé pour les lots dont les images sont rembourrées – cela conserve uniquement le vrai contenu à sa position exacte."
      },
      "image": {
        "name": "image",
        "tooltip": "Lot d’images ; chaque image devient une couche."
      },
      "layers": {
        "name": "layers",
        "tooltip": "Pile de couches à laquelle ajouter. Laissez non connecté pour démarrer une nouvelle pile."
      },
      "mask": {
        "name": "mask",
        "tooltip": "Transparence par image, alignée par index avec le lot d’images (1 = transparent, convention LoadImage)."
      }
    },
    "outputs": {
      "0": {
        "tooltip": "La pile de couches, prête pour Créer une image en couches."
      }
    }
  },
