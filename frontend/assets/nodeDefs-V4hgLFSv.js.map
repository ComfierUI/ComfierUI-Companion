  "BakeAmbientOcclusion": {
    "description": "Pré-calcule une carte d’occlusion ambiante d’un maillage high-poly dans le dépliage UV d’un low-poly (blanc = non obstrué, sombre = creux). Fournissez le low_poly déplié UV et le high_poly dont il a été décimé. Produit une IMAGE en niveaux de gris pour l’entrée occlusion de Apply Texture To Mesh (intégrée à la carte ORM / occlusionTexture).",
    "display_name": "Pré-calculer l’occlusion ambiante",
    "inputs": {
      "bias": {
        "name": "bias",
        "tooltip": "Élévation de l’origine des rayons au-dessus de la surface, en fraction de la diagonale de la boîte englobante. Augmentez si même les surfaces planes présentent des taches/trous sombres."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "low_poly": {
        "name": "low_poly"
      },
      "max_distance": {
        "name": "max_distance",
        "tooltip": "Longueur des rayons, en fraction de la diagonale de la boîte englobante. Plus petit = occlusion plus serrée et locale."
      },
      "resolution": {
        "name": "resolution"
      },
      "samples": {
        "name": "samples",
        "tooltip": "Rayons par texel. Plus = plus lisse, plus lent. Augmentez en cas de grain."
      },
      "strength": {
        "name": "strength",
        "tooltip": "Met à l’échelle l’occlusion. >1 assombrit, <1 éclaircit."
      }
    },
    "outputs": {
      "0": {
        "name": "occlusion",
        "tooltip": null
      }
    }
  },
  "BakeNormalMapFromMesh": {
    "description": "Pré-calcule une carte de normales en espace tangent (glTF/OpenGL +Y) d’un maillage high-poly dans le dépliage UV d’un low-poly, en capturant les détails perdus lors de la décimation. Fournissez le low_poly déplié UV et le high_poly dont il a été décimé. Produit une IMAGE pour l’entrée normal_map de Apply Texture To Mesh.",
    "display_name": "Pré-calculer une carte de normales depuis le maillage",
    "inputs": {
      "cage_distance": {
        "name": "cage_distance",
        "tooltip": "Plage de recherche de surface, en fraction de la diagonale de la boîte englobante. Augmentez pour les zones incorrectes ou manquantes sous forte décimation ; réduisez si elle capture des surfaces de l’autre côté des interstices."
      },
      "high_poly": {
        "name": "high_poly"
      },
      "ignore_backfaces": {
        "name": "ignore_backfaces",
        "tooltip": "Ignore les surfaces high-poly orientées à l’opposé du texel, afin que les creux et espaces clos ne capturent pas le mur opposé. Désactivez uniquement si l’ordre des sommets du high-poly est incohérent."
      },
      "low_poly": {
        "name": "low_poly"
      },
      "resolution": {
        "name": "resolution"
      }
    },
    "outputs": {
      "0": {
        "name": "normal_map",
        "tooltip": null
      }
    }
  },
  "BakeTextureFromVoxel": {
    "description": "Pré-calcule des textures PBR dans le dépliage UV existant du maillage (échantillonnage trilinéaire du volume voxel clairsemé). Ne déplie PAS — connectez un nœud de dépliage UV en amont. Produit des IMAGEs base_color et metallic/roughness en niveaux de gris (noires sans PBR) ; envoyez-les vers ApplyTextureToMesh (MÊME maillage) pour SaveGLB.",
    "display_name": "Pré-calculer la texture depuis le voxel",
    "inputs": {
      "mesh": {
        "name": "mesh"
      },
      "reference_mesh": {
        "name": "reference_mesh",
        "tooltip": "Maillage dense facultatif avant décimation ; reprojette chaque texel sur sa surface réelle avant l’échantillonnage, supprimant les artéfacts de cuisson facettés sur les maillages grossiers."
      },
      "texture_size": {
        "name": "texture_size",
        "tooltip": "Résolution de l’atlas UV carré."
      },
      "voxel_colors": {
        "name": "voxel_colors"
      }
    },
    "outputs": {
      "0": {
        "name": "base_color",
        "tooltip": null
      },
      "1": {
        "name": "metallic",
        "tooltip": null
      },
      "2": {
        "name": "roughness",
        "tooltip": null
      }
    }
  },
