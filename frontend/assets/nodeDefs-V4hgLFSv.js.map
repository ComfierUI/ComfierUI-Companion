  "IdeogramPImage": {
    "description": "Génère des images à l'aide de P-Image, le modèle texte-vers-image rapide d'Ideogram. Excellente typographie et photoréalisme ; prend en charge les légendes JSON structurées Ideogram 4.0 pour un texte, des couleurs et une mise en page exacts.",
    "display_name": "Ideogram & Pruna P-Image",
    "inputs": {
      "aspect_ratio": {
        "name": "aspect_ratio",
        "tooltip": "Le ratio d'aspect pour la génération d'image."
      },
      "control_after_generate": {
        "name": "control after generate"
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Prompt textuel. Accepte également une légende JSON structurée Ideogram 4.0 (couleurs exactes en hexadécimal #RRGGBB, chaînes de texte exactes, mise en page par boîte englobante) — réglez prompt_upsampling sur OFF pour l'utiliser tel quel."
      },
      "prompt_upsampling": {
        "name": "prompt_upsampling",
        "tooltip": "Développe les prompts courts en une légende structurée détaillée avant la génération (le prompt réécrit est renvoyé comme final_prompt). Réglez sur OFF lorsque vous fournissez votre propre légende JSON ou un texte exact."
      },
      "quality": {
        "name": "quality",
        "tooltip": "Niveau de vitesse/prix/qualité. MEDIUM est le choix par défaut quotidien ; HIGH pour des prompts complexes, des détails fins et du texte difficile ; VERY_LOW/LOW pour des brouillons à grande échelle. Le texte difficile est mal rendu en dessous de MEDIUM."
      },
      "resolution": {
        "name": "resolution",
        "tooltip": "Classe de taille de sortie (les pixels exacts suivent le ratio d'aspect, par exemple 16:9 donne 1280x720 en 1K et 2560x1440 en 2K). Préférez HIGH + 2K pour une typographie nette."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Graine pour une génération reproductible. Avec prompt_upsampling sur OFF, la même graine et les mêmes paramètres donnent la même image ; avec ON/AUTO, la réécriture du prompt varie à chaque exécution — reproduisez un résultat en réutilisant la sortie final_prompt avec prompt_upsampling sur OFF et la même graine."
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      },
      "1": {
        "name": "final_prompt",
        "tooltip": "Le prompt à partir duquel l'image a réellement été générée (la légende structurée réécrite si prompt_upsampling a été utilisé, sinon votre prompt). Réutilisez-le avec prompt_upsampling sur OFF et la même graine pour reproduire cette image."
      }
    }
  },
