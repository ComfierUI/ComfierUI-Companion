      },
      "layers": {
        "name": "calques",
        "tooltip": "Pile de calques à laquelle ajouter. Laisser non connecté pour démarrer une nouvelle pile."
      },
      "mask": {
        "name": "masque",
        "tooltip": "Masque de transparence pour ce calque. Les zones masquées (valeur 1) deviennent transparentes, en se multipliant avec tout canal alpha déjà présent dans l’image."
      },
      "name": {
        "name": "nom",
        "tooltip": "Nom du calque affiché dans l’éditeur de composition."
      },
      "opacity": {
        "name": "opacité",
        "tooltip": "Opacité initiale du calque."
      },
      "rotation": {
        "name": "rotation",
        "tooltip": "Rotation initiale en degrés, dans le sens horaire."
      },
      "width": {
        "name": "largeur",
        "tooltip": "Largeur d’affichage initiale. 0 conserve la largeur native de l’image."
      },
      "x": {
        "name": "x",
        "tooltip": "Position horizontale initiale sur le canevas."
      },
      "y": {
        "name": "y",
        "tooltip": "Position verticale initiale sur le canevas."
      },
      "z_index": {
        "name": "z_index",
        "tooltip": "Priorité d’empilement. Les calques sont triés de façon stable par z_index ; des valeurs égales conservent leur ordre dans la liste."
      }
    },
    "outputs": {
      "0": {
        "tooltip": "La pile de calques avec ce calque ajouté."
      }
    }
