  "RemeshMesh": {
    "description": "Réextrait un maillage uniformément tessellé via un champ de distance à bande étroite + Dual Contouring, sur le périphérique de calcul actif. Normalise les topologies désordonnées / non variétales / auto-intersectantes ; exécutez-le avant Decimate Mesh pour obtenir un nombre exact de faces. La sortie reste soudée.",
    "display_name": "Re-maillage du maillage (DC à bande étroite)",
    "inputs": {
      "band": {
        "name": "bande",
        "tooltip": "Largeur de la bande étroite en unités de voxels. En mode UDF, décale également la surface."
      },
      "drop_small_components": {
        "name": "drop_small_components",
        "tooltip": "Supprime les composants dont le nombre de faces est inférieur à cette fraction de celui du plus grand. 0 désactive cette option."
      },
      "fix_poles": {
        "name": "fix_poles",
        "tooltip": "Fusionne les paires de sommets de valence 3 (artefact de jonction en T DC)."
      },
      "mesh": {
        "name": "maillage"
      },
      "precluster_max_verts": {
        "name": "precluster_max_verts",
        "tooltip": "Limite le nombre de sommets en entrée avant les requêtes de champ ; les entrées au-delà de cette limite sont d’abord décimées par regroupement. Empêche les OOM sur les maillages volumineux."
      },
      "project_back": {
        "name": "project_back",
        "tooltip": "Interpole linéairement les sommets vers la surface d’origine (0 = DC pur, 1 = ajusté)."
      },
      "resolution": {
        "name": "résolution",
        "tooltip": "Résolution de la grille de voxels (densité de sortie). 256 ~ 100k faces, 512 ~ 1M. Pour un nombre exact de faces, enchaînez avec Decimate Mesh."
      },
      "sign_mode": {
        "name": "sign_mode",
        "tooltip": "udf : robuste face à une entrée désordonnée/non variétale. sdf : surface unique propre avec récupération des détails nets par QEF (Quadratic Error Function), mais nécessite une orientation cohérente."
      },
      "sign_mode_drop_enclosed_components": {
        "name": "drop_enclosed_components"
      },
      "sign_mode_drop_inverted_components": {
        "name": "drop_inverted_components"
      },
      "sign_mode_qef": {
        "name": "qef"
      },
      "smooth_iters": {
        "name": "smooth_iters",
        "tooltip": "Itérations de lissage de Taubin (0 = désactivé). 2-3 nettoient les artefacts DC en escalier ; des valeurs plus élevées lissent excessivement les arêtes QEF."
      }
