      "0": {
        "tooltip": null
      }
    }
  },
  "DA3Inference": {
    "description": "Exécuter Depth Anything 3 sur une image. En mode multi-vues, chaque image est traitée comme une vue séparée de la même scène.",
    "display_name": "Exécuter Depth Anything 3",
    "inputs": {
      "da3_model": {
        "name": "da3_model"
      },
      "image": {
        "name": "image"
      },
      "mode": {
        "name": "mode",
