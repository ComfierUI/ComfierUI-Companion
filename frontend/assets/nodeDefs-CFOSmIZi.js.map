  "BakeAmbientOcclusion": {
    "display_name": "Bake Ambient Occlusion",
    "description": "Bakes an ambient-occlusion map from a high-poly mesh into a low-poly's UV layout (white = open, dark = crevices). Feed the UV-unwrapped low_poly and the high_poly it was decimated from. Outputs a grayscale image for Apply Texture To Mesh's occlusion input (packed into the ORM map / occlusionTexture).",
    "inputs": {
      "low_poly": {
        "name": "low_poly"
      },
      "high_poly": {
        "name": "high_poly"
      },
      "resolution": {
        "name": "resolution"
      },
      "samples": {
        "name": "samples",
        "tooltip": "Rays per texel. More = smoother, slower. Raise if grainy."
      },
      "max_distance": {
        "name": "max_distance",
        "tooltip": "Ray length, as a fraction of the bounding box diagonal. Smaller = tighter, more local occlusion."
      },
      "strength": {
        "name": "strength",
        "tooltip": "Scales the occlusion. >1 darkens, <1 lightens."
      },
      "bias": {
        "name": "bias",
        "tooltip": "Ray origin lift off the surface, as a fraction of the bounding box diagonal. Raise if even surfaces show dark blotches/holes."
      }
    },
    "outputs": {
      "0": {
        "name": "occlusion",
        "tooltip": null
      }
    }
  },
  "BakeNormalMapFromMesh": {
    "display_name": "Bake Normal Map from Mesh",
    "description": "Bakes a tangent-space normal map (glTF/OpenGL +Y) from a high-poly mesh into a low-poly's UV layout, capturing detail lost during decimation. Feed the UV-unwrapped low_poly and the high_poly it was decimated from. Outputs an image for Apply Texture To Mesh's normal_map input.",
    "inputs": {
      "low_poly": {
        "name": "low_poly"
      },
      "high_poly": {
        "name": "high_poly"
      },
      "resolution": {
        "name": "resolution"
      },
      "cage_distance": {
        "name": "cage_distance",
        "tooltip": "Surface search band, as a fraction of the bounding box diagonal. Raise for wrong/missing patches under heavy decimation; lower if it grabs across gaps."
      },
      "ignore_backfaces": {
        "name": "ignore_backfaces",
        "tooltip": "Skip high-poly surfaces facing away from the texel, so crevices/enclosed spaces don't grab the opposite wall. Disable only if the high-poly winding is inconsistent."
      }
    },
    "outputs": {
      "0": {
        "name": "normal_map",
        "tooltip": null
      }
    }
  },
  "BakeTextureFromVoxel": {
    "display_name": "Bake Texture From Voxel",
    "description": "Bakes PBR textures onto the mesh's existing UV layout (trilinear-sample the sparse voxel volume). Does NOT unwrap — connect a UV unwrap node upstream. Outputs base_color + metallic/roughness grayscale IMAGEs (black if no PBR); feed them to ApplyTextureToMesh (SAME mesh) for SaveGLB.",
    "inputs": {
      "mesh": {
        "name": "mesh"
      },
      "voxel_colors": {
        "name": "voxel_colors"
      },
      "texture_size": {
        "name": "texture_size",
        "tooltip": "Square UV atlas resolution."
      },
      "reference_mesh": {
        "name": "reference_mesh",
        "tooltip": "Optional dense pre-decimation mesh; back-projects each texel onto its true surface before sampling, removing faceted baking on coarse meshes."
      }
    },
    "outputs": {
      "0": {
        "name": "base_color",
        "tooltip": null
      },
      "1": {
        "name": "metallic",
        "tooltip": null
      },
      "2": {
        "name": "roughness",
        "tooltip": null
      }
    }
  },
