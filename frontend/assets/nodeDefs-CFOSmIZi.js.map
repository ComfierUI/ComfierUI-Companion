        "tooltip": "CLIP vision of the reference image."
      },
      "positive_pose": {
        "name": "positive_pose",
        "tooltip": "Prompt for the pose-video branch, describing the motion rather than the character. Defaults to positive. Used for both the cond and uncond passes."
      },
      "clip_vision_output_pose": {
        "name": "clip_vision_output_pose",
        "tooltip": "CLIP vision of the pose video's first frame. Defaults to clip_vision_output."
