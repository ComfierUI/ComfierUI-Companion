  "LTXVSeparateGeneratedKeyframes": {
    "display_name": "LTXV Separate Generated Keyframes",
    "description": "Split the generated keyframes added by LTXV Add Generated Keyframes back out of a sampled latent, and remove them from the conditioning. Separate them before spatially upscaling the video latent. Do not run LTXV Crop Guides first — it treats generated keyframes as disposable guides and drops them.",
